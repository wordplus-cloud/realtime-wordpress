+/** A length-delimited field's data as protobuf-es keeps an unknown field's: its length, a varint, then the bytes. */
+export function lengthDelimited(bytes: Uint8Array): Uint8Array {
+  const head: number[] = [];
+  let n = bytes.length;
+  while (n >= 0x80) {
+    head.push((n & 0x7f) | 0x80);
+    n = Math.floor(n / 128);
+  }
+  head.push(n);
+  const out = new Uint8Array(head.length + bytes.length);
+  out.set(head, 0);
+  out.set(bytes, head.length);
+  return out;
+}
