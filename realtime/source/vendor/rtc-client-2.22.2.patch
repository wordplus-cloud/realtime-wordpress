+  for (const field of message.getType().runtime.bin.listUnknownFields(message)) {
+    if (field.no !== no || field.wireType !== 2) {
+      continue;
+    }
+    // a length-delimited field's data: its length, a varint, then the bytes
+    let length = 0;
+    let at = 0;
+    for (let shift = 0; at < field.data.length && shift < 35; shift += 7) {
+      const b = field.data[at++];
+      length += (b & 0x7f) * 2 ** shift;
+      if (b < 0x80) {
+        break;
+      }
+    }
+    try {
+      found.push(JSON.parse(new TextDecoder().decode(field.data.subarray(at, at + length))));
+    } catch {
