+// WordPlus Mesh (rtc-client 1.0.2): a browser holds a background tab's timers and its message handling back (Safari
+// above all), and on the page's return a due ping timeout may run before the messages that came meanwhile are read.
+describe('SignalClient ping timeout after the page was hidden', () => {
+  let client: any;
+  const setHidden = (hidden: boolean) => {
+    Object.defineProperty(document, 'hidden', { configurable: true, get: () => hidden });
+    document.dispatchEvent(new Event('visibilitychange'));
+  };
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    setHidden(false);
+    client = new SignalClient(false) as any;
+    client.pingTimeoutDuration = 15;
+    client.handleOnClose = vi.fn();
+    client.sendPing = vi.fn(() => Promise.resolve([]));
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    setHidden(false);
+  });
+
+  it('closes when the page stayed visible', () => {
+    client.resetPingTimeout();
+    vi.advanceTimersByTime(15_000);
+    expect(client.handleOnClose).toHaveBeenCalledWith('ping timeout');
+    expect(client.sendPing).not.toHaveBeenCalled();
+  });
+
+  it('pings once more, and a message read meanwhile keeps the connection', () => {
+    client.resetPingTimeout();
+    setHidden(true);
+    setHidden(false);
+    vi.advanceTimersByTime(15_000);
+    expect(client.sendPing).toHaveBeenCalledTimes(1);
+    expect(client.handleOnClose).not.toHaveBeenCalled();
+    client.resetPingTimeout(); // the answer read
+    vi.advanceTimersByTime(3_000);
+    expect(client.handleOnClose).not.toHaveBeenCalled();
+  });
+
+  it('closes after the grace when nothing answers, once', () => {
