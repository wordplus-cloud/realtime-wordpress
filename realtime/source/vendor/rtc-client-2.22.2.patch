+// The files' base and the UMD global, WordPlus RTC client's own: the package's scoped name would put a folder in the path.
+export const bundleName = 'rtc-client';
+export const globalName = 'WordPlusRTC';
+
+/**
+ * WordPlus RTC client: the packages a bundle is made of, as their paths under node_modules, into
+ * .bundle-modules/<name>.json (not in the package). The build turns them into THIRD-PARTY-NOTICES.txt,
+ * so every bundled package's licence goes with what ships it.
+ * @param {string} name
+ * @returns {import('rollup').Plugin}
+ */
+export function listModules(name) {
+  return {
+    name: 'list-modules',
+    generateBundle(_, bundle) {
+      // the modules whose code the output carries: a module tree-shaking emptied has nothing of its package in it
+      const ids = Object.values(bundle)
+        .flatMap((c) => (c.type === 'chunk' ? Object.entries(c.modules) : []))
+        .filter(([, m]) => m.renderedLength > 0)
+        .map(([id]) => id.replace(/\0/g, '').split('?')[0]);
+      const mods = ids
+        .filter((id) => id.includes('/node_modules/'))
+        .map((id) => id.slice(id.indexOf('/node_modules/') + '/node_modules/'.length));
+      // Babel's helpers, inlined from a module of its own with no path (babelHelpers: 'bundled'), are @babel/helpers' code
+      if (ids.some((id) => id.includes('BabelHelpers'))) mods.push('@babel/helpers/');
+      fs.mkdirSync('.bundle-modules', { recursive: true });
+      fs.writeFileSync(`.bundle-modules/${name}.json`, JSON.stringify([...new Set(mods)].sort(), null, 1));
+    },
+  };
+}
 
