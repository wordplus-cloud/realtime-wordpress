+// WordPlus Mesh: a signal response as a mesh node writes one with its region list (Go's protowire:
+// the field's tag, the JSON's length, the JSON), and nothing else
+function meshRegionsBytes(json: string, rest = new Uint8Array()): ArrayBuffer {
+  const body = new TextEncoder().encode(json);
+  const varint = (n: number) => {
+    const out: number[] = [];
+    while (n >= 0x80) {
+      out.push((n & 0x7f) | 0x80);
+      n = Math.floor(n / 128);
+    }
+    out.push(n);
+    return out;
+  };
+  const bytes = new Uint8Array([
+    ...rest,
+    ...varint((MESH_REGIONS_FIELD << 3) | 2),
+    ...varint(body.length),
+    ...body,
+  ]);
+  return bytes.buffer;
+}
+
+describe('meshRegions', () => {
+  const list = {
+    regions: [
+      { region: 'DE1', url: 'wss://n-5c03a.de.rtc.wordplus.cloud', distance: '0', node: 'ND_a' },
+      // over 127 bytes in all, so the length takes two bytes of its varint
+      {
+        region: 'BHS5',
+        url: 'wss://n-txvx7.bhs.rtc.wordplus.cloud',
+        distance: '6000000',
+        node: 'ND_b',
+      },
+    ],
+  };
+
+  it('reads the region list a mesh node sends, from a response no other client knows', () => {
+    const res = parseSignalResponse(meshRegionsBytes(JSON.stringify(list)));
+    expect(res.message.case).toBeUndefined();
+    expect(meshRegions(res)).toEqual(list);
+  });
+
+  it('is nothing for any other response, or a field it can not read', () => {
+    const leave = new SignalResponse({
+      message: { case: 'leave', value: new LeaveRequest({ canReconnect: true }) },
+    });
+    expect(meshRegions(leave)).toBeUndefined();
+    expect(meshRegions(parseSignalResponse(meshRegionsBytes('not json')))).toBeUndefined();
+    expect(meshRegions(parseSignalResponse(meshRegionsBytes('{"other":1}')))).toBeUndefined();
+  });
+});
 
