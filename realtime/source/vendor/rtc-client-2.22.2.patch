+    const r = raw as Record<string, unknown>;
+    const policy: MeshCodecPolicy = {};
+    const camera = names(r.camera);
+    const screen = names(r.screen);
+    if (camera) {
+      policy.camera = camera;
+    }
+    if (screen) {
+      policy.screen = screen;
+    }
+    if (typeof r.backup === 'string' && r.backup.length <= 16) {
+      policy.backup = r.backup;
+    }
+    return policy;
+  }
+  return undefined;
