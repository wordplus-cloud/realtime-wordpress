+import { SignalRequest } from '@livekit/protocol';
+import { describe, expect, it } from 'vitest';
+import { MESH_ENCODERS_FIELD, lengthDelimited } from '../api/utils';
+import { adapterEncoders, captureMode, encoderHardware, layersOf, sinceLast } from './meshEncoders';
+
+const layer = (rid: string, height: number, encoder?: string, extra: object = {}) => ({
+  rid,
+  height,
+  encoder,
+  active: true,
+  mime: 'video/H264',
+  ...extra,
+});
+
+describe('meshEncoders (WordPlus Mesh)', () => {
+  it('reads a simulcast adapter as one encoder a layer, the smallest first', () => {
+    // what Chrome 155 on a Mac gives a camera in H.264 Baseline (TestBrowserH264Encoder)
+    const name = 'SimulcastEncoderAdapter (OpenH264, VideoToolbox, VideoToolbox)';
+    expect(adapterEncoders(name)).toEqual(['OpenH264', 'VideoToolbox', 'VideoToolbox']);
+    const read = layersOf([layer('f', 1080, name), layer('q', 270, name), layer('h', 540, name)]);
+    expect(read?.layers).toEqual([
+      { rid: 'q', encoder: 'OpenH264', hw: false },
+      { rid: 'h', encoder: 'VideoToolbox', hw: true },
+      { rid: 'f', encoder: 'VideoToolbox', hw: true },
+    ]);
+  });
+
+  it('maps the adapter over the layers that encode, a paused one by its frames though it still reads active', () => {
+    // a camera whose 540p the server paused (dynacast): Chrome names the encoders of q and f alone (the lab, 2026-10-18)
+    const name = 'SimulcastEncoderAdapter (OpenH264, VideoToolbox)';
+    const read = layersOf([
+      layer('q', 270, name, { fps: 30 }),
+      layer('h', 540, name, { fps: 0 }),
+      layer('f', 1080, name, { fps: 29.6, limit: 'none' }),
+    ]);
+    expect(read?.layers).toEqual([
+      { rid: 'q', encoder: 'OpenH264', hw: false, fps: 30, height: 270 },
+      { rid: 'h' },
+      { rid: 'f', encoder: 'VideoToolbox', hw: true, fps: 30, height: 1080 },
+    ]);
+  });
+
+  it('says what holds a layer back while it encodes', () => {
+    // a 2560×1440 share in VP8 on a PC whose CPU can't keep up: Chrome lowers its frames and its size
+    const read = layersOf([
+      layer('q', 720, 'SimulcastEncoderAdapter (libvpx, libvpx)', { fps: 15, limit: 'none' }),
+      layer('h', 1080, 'SimulcastEncoderAdapter (libvpx, libvpx)', { fps: 8, limit: 'cpu' }),
+    ]);
+    expect(read?.layers[1]).toEqual({
+      rid: 'h',
+      encoder: 'libvpx',
+      hw: false,
+      fps: 8,
+      height: 1080,
+      limit: 'cpu',
+    });
+  });
+
+  it('gives every layer the one encoder an adapter names alone, however its layers read', () => {
+    const name = 'SimulcastEncoderAdapter (libvpx, libvpx)';
+    const read = layersOf([layer('q', 180, name), layer('h', 360, name), layer('f', 720, name)]);
+    expect(read?.layers).toEqual([
+      { rid: 'q', encoder: 'libvpx', hw: false },
+      { rid: 'h', encoder: 'libvpx', hw: false },
+      { rid: 'f', encoder: 'libvpx', hw: false },
+    ]);
+  });
+
+  it("takes one encoder for every layer, by its name or the browser's power efficiency", () => {
+    expect(
+      layersOf([layer('q', 270, 'MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)')])?.layers,
+    ).toEqual([
+      { rid: 'q', encoder: 'MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)', hw: true },
+    ]);
+    expect(encoderHardware('libvpx')).toBe(false);
+    expect(encoderHardware('OpenH264')).toBe(false);
+    expect(encoderHardware('libaom')).toBe(false);
+    expect(encoderHardware('VideoToolbox')).toBe(true);
+    expect(encoderHardware(undefined, true)).toBe(true);
+    expect(encoderHardware(undefined)).toBeNull();
+  });
+
+  it("tells a sender's layers whose browser names no encoder (Firefox, Safari), its encoder unnamed", () => {
+    const read = layersOf([layer('q', 180, undefined, { fps: 15 }), layer('h', 360, undefined, { fps: 15 })]);
+    expect(read?.encoder).toBe('');
+    expect(read?.layers).toEqual([
+      { rid: 'q', fps: 15, height: 180 },
+      { rid: 'h', fps: 15, height: 360 },
+    ]);
+    expect(layersOf([])).toBeUndefined();
+  });
+
+  it('takes what a layer did between two readings: ms a frame, key frames made and asked for', () => {
+    expect(sinceLast(undefined, { encodeTime: 1, frames: 30, keyFrames: 1, plis: 0 })).toEqual({});
+    // 10 s at 7 frames a second, 52 ms a frame, 6 key frames for 9 requests: a slow encoder in a storm of key frames
+    expect(
+      sinceLast(
+        { encodeTime: 10, frames: 1000, keyFrames: 20, plis: 30 },
+        { encodeTime: 13.64, frames: 1070, keyFrames: 26, plis: 39 },
+      ),
+    ).toEqual({ encodeMs: 52, keyFrames: 6, plis: 9 });
+    // a total the browser doesn't keep, or one that went back (a sender started over), says nothing
+    expect(sinceLast({ frames: 100, keyFrames: 5 }, { frames: 40, keyFrames: 6 })).toEqual({
+      keyFrames: 1,
+    });
+    // no frame encoded: no time a frame
+    expect(sinceLast({ encodeTime: 2, frames: 10 }, { encodeTime: 2, frames: 10 })).toEqual({});
+  });
+
+  it('puts the readings on a layer that encodes, not on one that does not', () => {
+    const name = 'SimulcastEncoderAdapter (OpenH264, MediaFoundationVideoEncodeAccelerator (AMDh264Encoder))';
+    const read = layersOf([
+      layer('q', 180, name, { fps: 3, encodeMs: 4.1, keyFrames: 0, plis: 0 }),
+      layer('h', 360, name, { fps: 3, encodeMs: 61.5, keyFrames: 6, plis: 9 }),
+      layer('f', 720, name, { fps: 0, keyFrames: 0, plis: 0 }),
+    ]);
+    expect(read?.layers[1]).toEqual({
+      rid: 'h',
+      encoder: 'MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)',
+      hw: true,
+      fps: 3,
+      height: 360,
+      encodeMs: 61.5,
+      keyFrames: 6,
+      plis: 9,
+    });
+    expect(read?.layers[2]).toEqual({ rid: 'f' });
+  });
+
+  it("says the mode a capture was opened at, from the track's settings", () => {
+    const track = (s: object) => ({ getSettings: () => s }) as unknown as MediaStreamTrack;
+    expect(captureMode(track({ width: 1920, height: 1080, frameRate: 15.000015 }))).toEqual({
+      width: 1920,
+      height: 1080,
+      fps: 15,
+    });
+    expect(captureMode(track({ width: 1280, height: 720 }))).toEqual({ width: 1280, height: 720 });
+    expect(captureMode(track({}))).toBeUndefined();
+    expect(captureMode(undefined)).toBeUndefined();
+  });
+
+  it('puts the report where a node reads it: a request with no message, the JSON in its unknown field', () => {
+    const req = new SignalRequest({});
+    const json = JSON.stringify({ tracks: [{ sid: 'TR_a', codecs: [] }] });
+    req
+      .getType()
+      .runtime.bin.onUnknownField(
+        req,
+        MESH_ENCODERS_FIELD,
+        2,
+        lengthDelimited(new TextEncoder().encode(json)),
+      );
+    const back = SignalRequest.fromBinary(req.toBinary());
+    expect(back.message.case).toBeUndefined();
+    const field = back
+      .getType()
+      .runtime.bin.listUnknownFields(back)
+      .find((f) => f.no === MESH_ENCODERS_FIELD);
+    expect(field?.wireType).toBe(2);
+    // the length, then the bytes
+    expect(new TextDecoder().decode(field!.data.subarray(1))).toBe(json);
+    // a long one's length takes two bytes
+    expect(lengthDelimited(new Uint8Array(300)).subarray(0, 2)).toEqual(
+      new Uint8Array([0xac, 0x02]),
+    );
+  });
+});
