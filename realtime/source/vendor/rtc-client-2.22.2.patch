diff --git a/src/room/Room.mesh.test.ts b/src/room/Room.mesh.test.ts
new file mode 100644
index 0000000..c7644aa
--- /dev/null
+++ b/src/room/Room.mesh.test.ts
@@ -0,0 +1,250 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import Room from './Room';
+import { ConnectionError } from './errors';
+import { addRegionDomains } from './utils';
+
+// the test environment has no WebRTC; connect checks for it before anything else
+vi.mock('./utils', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('./utils')>()),
+  isBrowserSupported: () => true,
+}));
+
+/**
+ * WordPlus Mesh: a join walks its list when mesh nodes say they are busy (the server's
+ * pkg/mesh/gate.go), and waits only once every server was busy, on its home region's that frees
+ * first, which keeps it a slot.
+ */
+describe('WordPlus Mesh: a join walks busy nodes', () => {
+  let n = 0;
+  let domain = '';
+  const regions = () => ({
+    regions: [
+      { region: 'de1', url: `wss://n-de1.${domain}`, node: 'ND_de1', distance: '0' },
+      { region: 'de1', url: `wss://n-de2.${domain}`, node: 'ND_de2', distance: '0' },
+      { region: 'sgp1', url: `wss://n-sg1.${domain}`, node: 'ND_sg1', distance: '10270000' },
+    ],
+  });
+  const refused = (refusedKind: string, node: string, retryAfter: number) =>
+    ConnectionError.internal('server full', {
+      status: 429,
+      retryAfter,
+      refused: refusedKind,
+      node,
+    });
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    domain = `walk${++n}.test`;
+    addRegionDomains(domain);
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => ({
+        ok: true,
+        status: 200,
+        json: async () => regions(),
+        headers: new Headers({ 'Cache-Control': 'max-age=30' }),
+      })),
+    );
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  // connect drives Room.connect with attemptConnection answering as answer says, and returns the
+  // servers it tried, in order
+  const connect = async (answer: (url: string, nth: number) => Error | undefined) => {
+    const room = new Room();
+    const tried: string[] = [];
+    const r = room as unknown as {
+      attemptConnection: (url: string) => Promise<void>;
+      recreateEngine: () => void;
+    };
+    r.attemptConnection = async (url: string) => {
+      tried.push(url);
+      const err = answer(url, tried.filter((u) => u === url).length);
+      if (err) {
+        throw err;
+      }
+    };
+    r.recreateEngine = () => {};
+    const done = room.connect(`wss://rtc.${domain}`, 'token');
+    await vi.advanceTimersByTimeAsync(30_000);
+    await done;
+    return tried;
+  };
+
+  it("tries its region's other nodes, then the nearest region's, then waits on its region's that frees first", async () => {
+    const tried = await connect((url, nth) => {
+      if (url === `wss://rtc.${domain}`) return refused('busy', 'ND_de1', 2_000);
+      if (url === `wss://n-de2.${domain}`) return refused('busy', 'ND_de2', 1_000);
+      if (url === `wss://n-sg1.${domain}`) return refused('busy', 'ND_sg1', 500);
+      if (url === `wss://n-de2.${domain}/?mesh_wait=1` && nth === 1)
+        return refused('slot', 'ND_de2', 2_000);
+      return undefined;
+    });
+    expect(tried).toEqual([
+      `wss://rtc.${domain}`, // the shared name reached de1's first node, busy
+      `wss://n-de2.${domain}`, // its region's other node, busy
+      `wss://n-sg1.${domain}`, // the nearest region's, busy: every server was
+      `wss://n-de2.${domain}/?mesh_wait=1`, // back home, on the one that frees first, waiting: a slot
+      `wss://n-de2.${domain}/?mesh_wait=1`, // on its slot
+    ]);
+  });
+
+  it('gets in on the next node at once when only its first is busy', async () => {
+    const tried = await connect((url) =>
+      url === `wss://rtc.${domain}` ? refused('busy', 'ND_de1', 1_000) : undefined,
+    );
+    expect(tried).toEqual([`wss://rtc.${domain}`, `wss://n-de2.${domain}`]);
+  });
+
+  // connectWith is connect with connect options, and how long to let the join run
+  const connectWith = async (
+    answer: (url: string, nth: number) => Error | undefined,
+    opts: Parameters<Room['connect']>[2],
+    runMs: number,
+  ) => {
+    const room = new Room();
+    const tried: string[] = [];
+    const r = room as unknown as {
+      attemptConnection: (url: string) => Promise<void>;
+      recreateEngine: () => void;
+    };
+    r.attemptConnection = async (url: string) => {
+      tried.push(url);
+      const err = answer(url, tried.filter((u) => u === url).length);
+      if (err) {
+        throw err;
+      }
+    };
+    r.recreateEngine = () => {};
+    let failed: unknown;
+    const done = room.connect(`wss://rtc.${domain}`, 'token', opts).catch((e) => {
+      failed = e;
+    });
+    await vi.advanceTimersByTimeAsync(runMs);
+    await done;
+    return { tried, failed };
+  };
+
+  it('says when it waits for a place, and why', async () => {
+    const waits: Array<{ until: number; reason: string }> = [];
+    const start = Date.now();
+    await connectWith(
+      (url, nth) => {
+        if (url === `wss://rtc.${domain}`) return refused('busy', 'ND_de1', 2_000);
+        if (url === `wss://n-de2.${domain}`) return refused('busy', 'ND_de2', 1_000);
+        if (url === `wss://n-sg1.${domain}`) return refused('busy', 'ND_sg1', 500);
+        if (url === `wss://n-de2.${domain}/?mesh_wait=1` && nth === 1)
+          return refused('slot', 'ND_de2', 2_000);
+        return undefined;
+      },
+      { onMeshWait: (w) => waits.push(w) },
+      30_000,
+    );
+    expect(waits.map((w) => w.reason)).toEqual(['busy', 'slot']);
+    expect(waits[0].until).toBeGreaterThanOrEqual(start + 1_000); // de2 frees first, 1 s on
+    expect(waits[1].until).toBeGreaterThanOrEqual(start + 2_000);
+  });
+
+  it('keeps waiting while the cluster is full as long as the product says (meshJoinBudgetMs)', async () => {
+    // full for a minute: the default 30 s gives up, two minutes get in
+    const fullFor = (until: number) => (url: string) =>
+      Date.now() < until ? refused('full', 'ND_de1', 5_000) : undefined;
+    let until = Date.now() + 60_000;
+    const short = await connectWith(fullFor(until), {}, 70_000);
+    expect(short.failed).toBeInstanceOf(ConnectionError);
+
+    until = Date.now() + 60_000;
+    const waits: string[] = [];
+    const long = await connectWith(
+      fullFor(until),
+      { meshJoinBudgetMs: 120_000, onMeshWait: (w) => waits.push(w.reason) },
+      70_000,
+    );
+    expect(long.failed).toBeUndefined();
+    expect(waits.length).toBeGreaterThan(5);
+    expect(new Set(waits)).toEqual(new Set(['full']));
+  });
+
+  it('comes back to the node that keeps it a slot when the cluster is full, by its own name', async () => {
+    const tried = await connect((url, nth) =>
+      url === `wss://rtc.${domain}` && nth === 1 ? refused('full', 'ND_de1', 3_000) : undefined,
+    );
+    expect(tried).toEqual([`wss://rtc.${domain}`, `wss://n-de1.${domain}/?mesh_wait=1`]);
+  });
+
