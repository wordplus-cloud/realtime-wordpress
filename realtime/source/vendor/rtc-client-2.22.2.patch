+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { forgetHardwareDecoders, hardwareDecoders, hardwareEncoders } from './hardwareDecoders';
+
+const withCapabilities = (mediaCapabilities: unknown) =>
+  vi.stubGlobal('navigator', Object.assign(Object.create(navigator), { mediaCapabilities }));
+
+describe('hardwareDecoders (WordPlus Mesh)', () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    forgetHardwareDecoders();
+  });
+
+  it('names the codecs decoded power efficiently, in a fixed order, asked for WebRTC at 720p', async () => {
+    const decodingInfo = vi.fn(async (config: { type: string; video: { contentType: string; height: number } }) => ({
+      supported: config.video.contentType !== 'video/AV1',
+      powerEfficient: !config.video.contentType.startsWith('video/VP8'),
+    }));
+    withCapabilities({ decodingInfo });
+    expect(await hardwareDecoders()).toEqual(['h264', 'h265', 'vp9']);
+    expect(decodingInfo.mock.calls.every(([c]) => c.type === 'webrtc' && c.video.height === 720)).toBe(true);
+  });
+
+  it('says nothing where the browser cannot tell: no mediaCapabilities, every probe refused, or no answer in time', async () => {
+    withCapabilities(undefined);
+    expect(await hardwareDecoders()).toBeUndefined();
+
+    forgetHardwareDecoders();
+    withCapabilities({ decodingInfo: async () => Promise.reject(new TypeError('no webrtc type')) });
+    expect(await hardwareDecoders()).toBeUndefined();
+
+    forgetHardwareDecoders();
+    withCapabilities({ decodingInfo: () => new Promise(() => {}) });
+    expect(await hardwareDecoders(20)).toBeUndefined();
+  });
+
+  it('says an empty list when it decodes none in hardware', async () => {
+    withCapabilities({ decodingInfo: async () => ({ supported: true, powerEfficient: false }) });
+    expect(await hardwareDecoders()).toEqual([]);
+  });
+
+  it('counts H.264 encoded in hardware in Baseline as well as Constrained Baseline, as Chrome on a desktop answers', async () => {
+    // Chrome 155 on a Mac: VideoToolbox for Baseline, OpenH264 for Constrained Baseline; H.265 in hardware
+    const chrome = async (config: { video: { contentType: string } }) => ({
+      supported: true,
+      powerEfficient: /42001f|h265/i.test(config.video.contentType),
+    });
+    const encodingInfo = vi.fn(chrome);
+    const decodingInfo = vi.fn(chrome);
+    withCapabilities({ encodingInfo, decodingInfo });
+    expect(await hardwareEncoders()).toEqual(['h264', 'h265']);
+    // the decoders are asked as before, Constrained Baseline alone
+    expect(await hardwareDecoders()).toEqual(['h265']);
+    expect(decodingInfo.mock.calls.some(([c]) => /42001f/.test(c.video.contentType))).toBe(false);
+  });
+
+  it('counts H.264 once when both answers say hardware, and not at all when neither does', async () => {
+    withCapabilities({ encodingInfo: async () => ({ supported: true, powerEfficient: true }) });
+    expect(await hardwareEncoders()).toEqual(['h264', 'h265', 'vp8', 'vp9', 'av1']);
+
+    forgetHardwareDecoders();
+    withCapabilities({ encodingInfo: async (c: { video: { contentType: string } }) => ({ supported: true, powerEfficient: c.video.contentType === 'video/H265' }) });
+    expect(await hardwareEncoders()).toEqual(['h265']);
+  });
+});
