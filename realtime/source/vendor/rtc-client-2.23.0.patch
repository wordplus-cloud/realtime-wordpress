+    if (!this.onMesh || this.state !== ConnectionState.Connected || !this.engine) {
+      return;
+    }
+    const tracks: MeshEncoderTrack[] = [];
+    for (const pub of this.localParticipant.videoTrackPublications.values()) {
+      const track = pub.videoTrack;
