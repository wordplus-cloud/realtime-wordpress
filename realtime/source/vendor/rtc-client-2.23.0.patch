@@ -0,0 +1,109 @@
+/**
+ * WordPlus Mesh: the video codecs this browser decodes in hardware, which a join names (mesh_hwdec) so the node
+ * gives it a track in one of them before any other codec the track has, and its CPU decodes only what it has no
+ * hardware for. Asked once a page of navigator.mediaCapabilities, for WebRTC at 720p: a codec counts when it is
+ * supported and power efficient. Undefined where the browser can't tell (no mediaCapabilities, or no answer within
+ * the wait), and a join then says nothing: the node gives it the track's own codec first, as before.
+ *
+ * 1.0.8: and those it encodes in hardware, which a join names too (mesh_hwenc), for the node's live view: what a
+ * server's codec policy (Room.meshCodecPolicy) could have each publisher send, before it asks for it.
+ */
+const PROBES: [name: string, contentType: string][] = [
+  ['h264', 'video/H264;profile-level-id=42e01f;packetization-mode=1'],
+  ['h265', 'video/H265'],
+  ['vp8', 'video/VP8'],
+  ['vp9', 'video/VP9'],
+  ['av1', 'video/AV1'],
+];
+
+/**
+ * 1.0.9: encoders are asked of H.264 Baseline too, and H.264 counts when either answer does. Chrome on a desktop
+ * encodes Baseline, Main and High in hardware (VideoToolbox on a Mac, Media Foundation on Windows) and the Constrained
+ * Baseline asked above in OpenH264, and answers so per profile (Chrome 155, 2026-10-18); WordPlus Mesh 1.0.34 takes
+ * its Baseline, so its H.264 is hardware's, which the live view showed as software. Decoders answer alike for both.
+ */
+const ENCODE_PROBES: [name: string, contentType: string][] = [
+  ...PROBES,
+  ['h264', 'video/H264;profile-level-id=42001f;packetization-mode=1'],
+];
+
+/** How long a join waits for the answer, the first time. */
+export const hardwareDecodersWaitMs = 300;
+
+type Kind = 'decodingInfo' | 'encodingInfo';
+
+const asked: Partial<Record<Kind, Promise<string[] | undefined>>> = {};
+
+type CapabilitiesProbe = Partial<
+  Record<Kind, (config: unknown) => Promise<{ supported: boolean; powerEfficient?: boolean }>>
+>;
+
+async function probe(kind: Kind): Promise<string[] | undefined> {
+  const capabilities =
+    typeof navigator !== 'undefined'
+      ? ((navigator as unknown as { mediaCapabilities?: CapabilitiesProbe }).mediaCapabilities ??
+        undefined)
+      : undefined;
+  const ask = capabilities?.[kind];
+  if (!capabilities || typeof ask !== 'function') {
+    return undefined;
+  }
+  let answered = 0;
+  const found: string[] = [];
+  await Promise.all(
+    (kind === 'encodingInfo' ? ENCODE_PROBES : PROBES).map(async ([name, contentType]) => {
+      try {
+        const info = await ask.call(capabilities, {
+          type: 'webrtc',
+          video: { contentType, width: 1280, height: 720, bitrate: 2_000_000, framerate: 30 },
+        });
+        answered++;
+        if (info.supported && info.powerEfficient) {
+          found.push(name);
+        }
+      } catch {
+        // a codec this browser doesn't know by that name
+      }
+    }),
+  );
+  if (answered === 0) {
+    return undefined;
+  }
+  return PROBES.map(([name]) => name).filter((name) => found.includes(name));
+}
+
+async function inHardware(kind: Kind, waitMs: number): Promise<string[] | undefined> {
+  asked[kind] ??= probe(kind).catch(() => undefined);
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const late = new Promise<undefined>((resolve) => {
+    timer = setTimeout(() => resolve(undefined), waitMs);
+  });
+  try {
+    return await Promise.race([asked[kind]!, late]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/**
+ * The codecs this browser decodes in hardware, as the join names them ("h264", "h265", "vp8", "vp9", "av1"); undefined
+ * when it can't tell within `waitMs`. The answer stays for the page.
+ */
+export function hardwareDecoders(
+  waitMs: number = hardwareDecodersWaitMs,
+): Promise<string[] | undefined> {
+  return inHardware('decodingInfo', waitMs);
+}
+
+/** WordPlus Mesh (1.0.8): the codecs this browser encodes in hardware, as hardwareDecoders() those it decodes. */
+export function hardwareEncoders(
+  waitMs: number = hardwareDecodersWaitMs,
+): Promise<string[] | undefined> {
+  return inHardware('encodingInfo', waitMs);
+}
+
+/** @internal for tests: ask again. */
+export function forgetHardwareDecoders() {
+  delete asked.decodingInfo;
+  delete asked.encodingInfo;
+}
