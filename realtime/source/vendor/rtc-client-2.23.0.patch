+   * small call, less often in a big room, never at 0), or at once when what happened can't wait: CPU under serious
+   * pressure or a hang (meshHealth.ts), its own camera stopping by itself, a freeze in what it plays. A reading between
+   * two that isn't sent costs nothing: the next one says everything since the last that was.
+   */
+  private meshReportTick = async () => {
+    const every = this.meshReportEvery;
+    if (every <= 0 || !this.onMesh || this.state !== ConnectionState.Connected || !this.engine) {
+      return;
+    }
+    try {
+      if (
+        Date.now() - this.meshReportedAt < every - REPORT_EVERY_MS / 2 &&
+        !(await this.meshTroubled())
+      ) {
+        return;
+      }
+      this.meshReportedAt = Date.now();
+      await this.reportMeshEncoders();
+    } catch (e) {
+      this.log.debug('mesh report failed', { ...this.logContext, error: e });
+    }
+  };
+
+  /** Whether something since the last report can't wait for the next one (meshReportTick). */
+  private async meshTroubled(): Promise<boolean> {
+    if (this.meshHealth.troubled()) {
+      return true;
+    }
+    for (const pub of this.localParticipant.videoTrackPublications.values()) {
+      if (sourceStalled(pub.videoTrack?.mediaStreamTrack)) {
