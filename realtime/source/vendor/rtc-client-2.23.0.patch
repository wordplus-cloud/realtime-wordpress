+        : undefined;
+    const receivers = await this.readMeshReceivers();
+    // 1.0.16: the machine and the page, with each connection's path from its shared reading
+    const pcs = this.engine.pcManager;
+    const pathOf = (pc: StatsConnection | undefined) =>
+      pc ? this.meshStats.read(pc)?.catch(() => undefined) : undefined;
+    const health = await this.meshHealth.reading({
+      pub: await pathOf(pcs?.publisher),
+      sub: await pathOf(pcs?.subscriber),
+    });
+    // 1.0.16: one message for the node, every report of the reading in a field of its own
+    const sent = await this.engine.client.sendMeshReports({
+      encoders,
+      receivers: receivers.length ? receivers : undefined,
+      health: Object.keys(health).length ? health : undefined,
