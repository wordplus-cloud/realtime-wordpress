index 0000000..1116777
--- /dev/null
+++ b/src/room/meshHealth.test.ts
@@ -0,0 +1,189 @@
+import { SignalRequest, SignalResponse } from '@livekit/protocol';
+import { describe, expect, it } from 'vitest';
+import {
+  MESH_ENCODERS_FIELD,
+  MESH_HEALTH_FIELD,
+  MESH_RECEIVERS_FIELD,
+  MESH_REPORTS_FIELD,
+  lengthDelimited,
+  meshReportsEvery,
+} from '../api/utils';
+import { MeshHealthWatch } from './meshHealth';
+
+/** A connection's reading with its selected path, as Chrome gives it. */
+const path = (values: Record<string, number>) =>
+  new Map<string, any>([
+    [
+      'T',
+      {
+        id: 'T',
+        type: 'transport',
+        selectedCandidatePairId: 'P',
+        selectedCandidatePairChanges: values.switched ?? 1,
+      },
+    ],
+    ['P', { id: 'P', type: 'candidate-pair', ...values }],
+  ]);
+
+describe('meshHealth (WordPlus Mesh)', () => {
+  it('says the worst CPU pressure and how long it was serious, then starts over from the state it is in', async () => {
+    const w = new MeshHealthWatch();
+    const t0 = 1_000_000;
+    // started without a running page: no observers here, the events given by hand
+    w.pressureChanged('fair', t0);
+    w.pressureChanged('serious', t0 + 2000);
+    w.pressureChanged('critical', t0 + 5000);
+    w.pressureChanged('fair', t0 + 6000);
+    expect(w.troubled()).toBe(true);
+    const r = await w.reading({}, t0 + 10_000);
+    expect(r.cpu).toBe('critical');
+    expect(r.cpuMs).toBe(4000);
+    // the next reading: still fair, nothing serious, nothing to say of the CPU
+    w.tellMachineAgain();
+    const next = await w.reading({}, t0 + 20_000);
+    expect(next.cpu).toBe('fair');
+    expect(next.cpuMs).toBeUndefined();
+    expect(w.troubled()).toBe(false);
+  });
+
+  it('counts the time the page was hidden, across a reading too', async () => {
+    const w = new MeshHealthWatch();
+    w.visibilityChanged(true, 1000);
+    w.visibilityChanged(false, 4000);
+    w.visibilityChanged(true, 8000);
+    expect((await w.reading({}, 10_000)).hiddenMs).toBe(5000);
+    w.visibilityChanged(false, 12_000);
+    expect((await w.reading({}, 20_000)).hiddenMs).toBe(2000);
+  });
+
+  it('reads each connection’s path: round trip, upload, and what changed since the last reading', async () => {
+    const w = new MeshHealthWatch();
+    const first = await w.reading(
+      {
+        pub: path({
+          currentRoundTripTime: 0.02,
+          availableOutgoingBitrate: 2_500_000,
+          packetsDiscardedOnSend: 0,
+          consentRequestsSent: 10,
+          responsesReceived: 10,
+        }),
+      },
+      1000,
+    );
+    expect(first.pub).toEqual({ rtt: 20, outKbps: 2500 });
+    // Wi-Fi dropping out: 40 packets the system couldn't send, 3 checks unanswered, the path changed once
+    const second = await w.reading(
+      {
+        pub: path({
+          currentRoundTripTime: 0.25,
+          availableOutgoingBitrate: 300_000,
+          packetsDiscardedOnSend: 40,
+          consentRequestsSent: 14,
+          responsesReceived: 11,
+          switched: 2,
+        }),
+        sub: undefined,
+      },
+      11_000,
+    );
+    expect(second.pub).toEqual({
+      rtt: 250,
+      outKbps: 300,
+      sendFailed: 40,
+      unanswered: 3,
+      switched: 1,
+    });
+    expect(second.sub).toBeUndefined();
+  });
+
+  it('tells the machine once a connection', async () => {
+    const w = new MeshHealthWatch();
+    const first = await w.reading({}, 1000);
+    // vitest's environment may name cores or not; either way only the first reading says it
+    const said = first.machine !== undefined;
+    expect((await w.reading({}, 2000)).machine).toBeUndefined();
+    w.tellMachineAgain();
+    expect((await w.reading({}, 3000)).machine !== undefined).toBe(said);
+  });
+
+  it('tells the camera report once, at once for a switch, again after a reconnect, cut to its limit', async () => {
+    const w = new MeshHealthWatch();
+    expect((await w.reading({}, 1000)).camera).toBeUndefined();
+    const checked = {
+      codec: 'vp9',
+      source: 'check' as const,
+      checkMs: 2400,
+      tests: [{ codec: 'vp9', result: 'pass' as const, msPerFrame: 12.8, sentShare: 0.98 }],
+    };
+    w.setCamera(checked);
+    expect(w.troubled()).toBe(false); // a check's result waits for the next reading
+    expect((await w.reading({}, 2000)).camera).toEqual(checked);
+    expect((await w.reading({}, 3000)).camera).toBeUndefined();
+    w.setCamera({
+      ...checked,
+      codec: 'h264',
+      source: 'switch',
+      switches: [{ from: 'vp9', to: 'h264', why: 'cpu', at: 3500 }],
+    });
+    expect(w.troubled()).toBe(true); // a switch goes at once
+    expect((await w.reading({}, 4000)).camera?.switches).toHaveLength(1);
+    expect(w.troubled()).toBe(false);
+    w.tellMachineAgain();
+    expect((await w.reading({}, 5000)).camera?.codec).toBe('h264');
+    // over the limit: the oldest tests go first, and what's left fits
+    w.setCamera({
+      codec: 'vp8',
+      tests: Array.from({ length: 40 }, (_, i) => ({
+        codec: `codec-${i}-${'x'.repeat(60)}`,
+        result: 'error' as const,
+      })),
+    });
+    const cut = (await w.reading({}, 6000)).camera!;
+    expect(JSON.stringify(cut).length).toBeLessThanOrEqual(2048);
+    expect(cut.tests!.length).toBeGreaterThan(0);
+    expect(cut.tests!.at(-1)!.codec).toMatch(/^codec-39-/);
+  });
+
+  it('takes the node’s pace from a signal response of its own', () => {
+    const res = new SignalResponse({});
+    res
+      .getType()
+      .runtime.bin.onUnknownField(
+        res,
+        MESH_REPORTS_FIELD,
+        2,
+        lengthDelimited(new TextEncoder().encode('{"every":30000}')),
+      );
+    expect(meshReportsEvery(SignalResponse.fromBinary(res.toBinary()))).toBe(30_000);
+    expect(meshReportsEvery(new SignalResponse({}))).toBeUndefined();
+  });
+
+  it('puts a reading’s reports in one request, a field each, as the node reads them', () => {
+    const req = new SignalRequest({});
+    const fields: [number, object][] = [
+      [MESH_ENCODERS_FIELD, { tracks: [{ sid: 'TR_c' }] }],
+      [MESH_RECEIVERS_FIELD, { tracks: [{ sid: 'TR_v', kind: 'video', fps: 30 }] }],
+      [MESH_HEALTH_FIELD, { cpu: 'serious', hangs: 2 }],
+    ];
+    for (const [no, body] of fields) {
+      req
+        .getType()
+        .runtime.bin.onUnknownField(
+          req,
+          no,
+          2,
+          lengthDelimited(new TextEncoder().encode(JSON.stringify(body))),
+        );
+    }
+    const back = SignalRequest.fromBinary(req.toBinary());
+    const got = back.getType().runtime.bin.listUnknownFields(back);
+    expect(got.map((f) => f.no)).toEqual([
+      MESH_ENCODERS_FIELD,
+      MESH_RECEIVERS_FIELD,
+      MESH_HEALTH_FIELD,
+    ]);
+    // an unknown field's data keeps its length in front
+    const json = new TextDecoder().decode(got[2].data);
+    expect(JSON.parse(json.slice(json.indexOf('{')))).toEqual({ cpu: 'serious', hangs: 2 });
+  });
+});
