index 0000000..9f7957e
--- /dev/null
+++ b/src/room/meshStats.ts
@@ -0,0 +1,221 @@
+/**
+ * WordPlus Mesh (rtc-client 1.0.16): one reading of each connection's stats, shared, so telling the node more of what
+ * a client sends, plays and runs on adds no load to the client.
+ *
+ * Upstream reads every track's stats on its own, every 2 s (`monitorFrequency`): a receiver or a sender each time,
+ * and the browser gathers its connection's stats to answer each one. In a call of 8 that was 80 reads every 10 s a
+ * participant, and the reports to the node 15 more (test/msengine/statsload_test.go, 1.0.15): reads that grow with
+ * every person in the call. Here a connection is read at most once every READ_EVERY_MS, and each track's monitor and
+ * the reports take their own part of that one reading (`forReceiver`, `forSender`): what was read of the track, and
+ * what that refers to (its codec, its transport and the path it runs on, the far end's reports). Rates stay right:
+ * a monitor computes them between two readings by the stats' own timestamps.
+ *
+ * Only on the mesh's servers (a Room registers its connections while on one); anywhere else, and for a track whose
+ * part can't be told in the connection's reading (a browser that names no track on its inbound stats), each reads its
+ * own as upstream does. The library's public stats methods (getRTCStatsReport, getReceiverStats, getSenderStats) still
+ * read now: only its monitors and the mesh's reports share.
+ */
+
+/** A shared reading is reused this long: just under upstream's 2 s, so each connection is read about once a round. */
+export const READ_EVERY_MS = 1900;
+
+type Reading = { at: number; report: Promise<RTCStatsReport> };
+
+/** What the hub needs of a connection (PCTransport has it): its stats, its transceivers and senders. */
+export interface StatsConnection {
+  getStats(): Promise<RTCStatsReport> | undefined;
+  getTransceivers(): RTCRtpTransceiver[];
+  getSenders(): RTCRtpSender[];
+}
+
+/** Every room's connections while on the mesh: a page holds one call, but nothing here assumes it. */
+const hubs = new Set<MeshStatsHub>();
+
+export class MeshStatsHub {
+  /** the room's connections as they are now (a full reconnect makes new ones): its publisher's and subscriber's */
+  private connections: () => (StatsConnection | undefined)[] = () => [];
+
+  private readings = new WeakMap<StatsConnection, Reading>();
+
+  /** reads made, for tests and the lab */
+  reads = 0;
+
+  /** Shares the readings of the connections `connections` gives, until close(). */
+  open(connections: () => (StatsConnection | undefined)[]) {
+    this.connections = connections;
+    hubs.add(this);
+  }
+
+  close() {
+    this.connections = () => [];
+    hubs.delete(this);
+  }
+
+  private pcs(): StatsConnection[] {
+    return this.connections().filter((c): c is StatsConnection => !!c);
+  }
+
+  /** The connection's stats, read at most once every READ_EVERY_MS however many ask. */
+  read(pc: StatsConnection): Promise<RTCStatsReport> | undefined {
+    const now = Date.now();
+    const last = this.readings.get(pc);
+    if (last && now - last.at < READ_EVERY_MS) {
+      return last.report;
+    }
+    const report = pc.getStats();
+    if (!report) {
+      return undefined;
+    }
+    this.reads++;
+    this.readings.set(pc, { at: now, report });
+    // a failed reading isn't kept: the next one asks again
+    report.catch(() => {
+      if (this.readings.get(pc)?.report === report) {
+        this.readings.delete(pc);
+      }
+    });
+    return report;
+  }
+
+  /** The receiver's part of its connection's shared reading; undefined where this hub doesn't hold it. */
+  async forReceiver(receiver: RTCRtpReceiver): Promise<Map<string, any> | undefined> {
+    const pc = this.pcs().find((c) => c.getTransceivers().some((t) => t.receiver === receiver));
+    const id = receiver.track?.id;
+    const reading = pc && id ? this.read(pc) : undefined;
+    if (!reading) {
+      return undefined;
+    }
+    const full = await reading;
+    const picked: any[] = [];
+    full.forEach((s: any) => {
+      if (s.type === 'inbound-rtp' && s.trackIdentifier === id) {
+        picked.push(s);
+      }
+    });
+    return picked.length ? withReferences(full, picked) : undefined;
+  }
+
+  /**
+   * The sender's part of its connection's shared reading: its outbound streams, by its transceiver's mid, or where
+   * the browser names none on them, by its track through their media source (a backup codec's sender sends the same
+   * track, so the mid comes first); undefined where this hub doesn't hold it or can't tell its streams.
+   */
+  async forSender(sender: RTCRtpSender): Promise<Map<string, any> | undefined> {
+    const pc = this.pcs().find((c) => c.getSenders().includes(sender));
+    const reading = pc ? this.read(pc) : undefined;
+    if (!pc || !reading) {
+      return undefined;
+    }
+    const mid = pc.getTransceivers().find((t) => t.sender === sender)?.mid ?? undefined;
+    const full = await reading;
+    const picked: any[] = [];
+    let named = false;
+    full.forEach((s: any) => {
+      if (s.type !== 'outbound-rtp') {
+        return;
+      }
+      if (typeof s.mid === 'string') {
+        named = true;
+        if (mid && s.mid === mid) {
+          picked.push(s);
+        }
+      }
+    });
+    if (!named) {
+      const id = sender.track?.id;
+      const sources = new Set<string>();
+      full.forEach((s: any) => {
+        if (s.type === 'media-source' && id && s.trackIdentifier === id) {
+          sources.add(s.id);
+        }
+      });
+      // the same track in two senders can't be told apart without a mid
+      let senders = 0;
+      pc.getSenders().forEach((x) => {
+        if (x.track && x.track.id === id) {
+          senders++;
+        }
+      });
+      if (senders !== 1) {
+        return undefined;
+      }
+      full.forEach((s: any) => {
+        if (s.type === 'outbound-rtp' && sources.has(s.mediaSourceId)) {
+          picked.push(s);
+        }
+      });
+    }
+    return picked.length ? withReferences(full, picked) : undefined;
+  }
+}
+
+/** The fields of a stats entry that name another one. */
+const REFERENCES = [
+  'codecId',
+  'transportId',
+  'remoteId',
+  'mediaSourceId',
+  'selectedCandidatePairId',
+  'localCandidateId',
+  'remoteCandidateId',
+];
+
+/** Those entries with every one they refer to, and what those refer to, as a report of their own (a Map, as a report is maplike). */
+export function withReferences(full: { get(id: string): any }, picked: any[]): Map<string, any> {
+  const out = new Map<string, any>();
+  const queue = [...picked];
+  while (queue.length) {
+    const s = queue.shift();
+    if (!s || out.has(s.id)) {
+      continue;
+    }
+    out.set(s.id, s);
+    for (const k of REFERENCES) {
+      const ref = s[k];
+      if (typeof ref === 'string' && !out.has(ref)) {
+        const next = full.get(ref);
+        if (next) {
+          queue.push(next);
+        }
+      }
+    }
+  }
+  return out;
+}
+
+/**
+ * A receiver's or a sender's stats for the library's monitors and the mesh's reports: its part of its connection's
+ * shared reading on the mesh, or its own reading anywhere else.
+ */
+export async function sharedReceiverStats(
+  receiver: RTCRtpReceiver,
+): Promise<RTCStatsReport | Map<string, any>> {
+  for (const hub of hubs) {
+    try {
+      const part = await hub.forReceiver(receiver);
+      if (part) {
+        return part;
+      }
+    } catch {
+      // read its own below
+    }
+  }
+  return receiver.getStats();
+}
+
+/** The same for a sender. */
+export async function sharedSenderStats(
+  sender: RTCRtpSender,
+): Promise<RTCStatsReport | Map<string, any>> {
+  for (const hub of hubs) {
+    try {
+      const part = await hub.forSender(sender);
+      if (part) {
+        return part;
+      }
+    } catch {
+      // read its own below
+    }
+  }
+  return sender.getStats();
+}
