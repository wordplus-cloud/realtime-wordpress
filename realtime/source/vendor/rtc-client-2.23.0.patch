+/**
+ * WordPlus Mesh (rtc-client 1.0.16): how the machine and the page running a call are doing, told to the node with the
+ * other reports (MESH_HEALTH_FIELD), numbers and the device's names only. A call where a viewer's playback froze on
+ * every camera at once and its own camera stopped arriving, on a clean line (2026-10-23), was a PC that hung; nothing the node saw could say so.
+ *
+ * Nothing here runs a timer of its own, so collecting it adds no load to the client: the CPU pressure the system
+ * reports (Compute Pressure API), the main thread's long tasks (Long Tasks API), the page going hidden and shown, the
+ * battery charging or not, devices plugged in or out: each an event the browser raises anyway, which adds to a
+ * counter. The path each connection runs on comes from the connections' shared reading (meshStats.ts). A browser that
+ * has none of an API gives none of its numbers.
+ */
+import { MESH_CAMERA_MAX } from '../api/utils';
+import type { MeshCamera, MeshHealth, MeshPathHealth } from '../api/utils';
+
+type Pressure = NonNullable<MeshHealth['cpu']>;
+const PRESSURE_RANK: Record<Pressure, number> = { nominal: 0, fair: 1, serious: 2, critical: 3 };
+
+/** A main-thread task this long or longer is a hang worth telling (the Long Tasks API reports from 50 ms). */
+export const HANG_MS = 200;
+
+/** The PressureObserver's sample interval: it raises an event only when the state changes. */
+const PRESSURE_SAMPLE_MS = 2000;
+
+/** What has happened since the last reading, kept by the page's events. */
+type Counters = {
+  cpu?: Pressure;
+  cpuMs: number;
+  pressure?: Pressure;
+  pressureAt: number;
+  hangs: number;
+  hangMs: number;
+  hiddenMs: number;
+  hiddenAt?: number;
+  devices: number;
+};
+
+const fresh = (): Counters => ({
+  cpuMs: 0,
+  pressureAt: Date.now(),
+  hangs: 0,
+  hangMs: 0,
+  hiddenMs: 0,
+  devices: 0,
+});
+
+/** Each connection's path totals at the last reading, for what changed since. */
+type PathTotals = { sendFailed?: number; asked?: number; answered?: number; switched?: number };
+
+export class MeshHealthWatch {
+  private c: Counters = fresh();
+
+  private battery?: boolean;
+
+  private stops: (() => void)[] = [];
+
+  private paths = new Map<string, PathTotals>();
+
+  private machineSaid = false;
+
+  /** the product's latest camera report (setCamera), and whether a reading has told it since */
+  private camera?: MeshCamera;
+
+  private cameraSaid = true;
+
+  private static gpu?: Promise<string | undefined>;
+
+  /** Starts counting: every listener and observer the browser has, none it hasn't. */
+  start() {
+    if (this.stops.length) {
+      return;
+    }
+    this.c = fresh();
+    const g = globalThis as any;
+    // CPU pressure (Chrome and Edge 125 and later): the state the system is in, raised when it changes
+    if (typeof g.PressureObserver === 'function') {
+      try {
+        const observer = new g.PressureObserver((records: { state: Pressure }[]) => {
+          for (const r of records) {
+            this.pressureChanged(r.state);
+          }
+        });
+        Promise.resolve(observer.observe('cpu', { sampleInterval: PRESSURE_SAMPLE_MS })).catch(
+          () => {},
+        );
+        this.stops.push(() => observer.disconnect());
+      } catch {
+        // not allowed here (a frame without the permission policy)
+      }
+    }
+    // the main thread busy at a stretch: the page itself hangs (its timers, the call's own handling of the network)
+    if (
+      typeof g.PerformanceObserver === 'function' &&
+      g.PerformanceObserver.supportedEntryTypes?.includes('longtask')
+    ) {
+      try {
+        const observer = new g.PerformanceObserver(
+          (list: { getEntries(): { duration: number }[] }) => {
+            for (const e of list.getEntries()) {
+              if (e.duration >= HANG_MS) {
+                this.c.hangs++;
+                this.c.hangMs = Math.max(this.c.hangMs, Math.round(e.duration));
+              }
+            }
+          },
+        );
+        observer.observe({ type: 'longtask' });
+        this.stops.push(() => observer.disconnect());
+      } catch {
+        // no long tasks here
+      }
+    }
+    if (typeof document !== 'undefined' && typeof document.addEventListener === 'function') {
+      const visibility = () => this.visibilityChanged(document.visibilityState === 'hidden');
+      visibility();
+      document.addEventListener('visibilitychange', visibility);
+      this.stops.push(() => document.removeEventListener('visibilitychange', visibility));
+    }
+    const devices = g.navigator?.mediaDevices;
+    if (devices && typeof devices.addEventListener === 'function') {
+      const changed = () => {
+        this.c.devices++;
+      };
+      devices.addEventListener('devicechange', changed);
+      this.stops.push(() => devices.removeEventListener('devicechange', changed));
+    }
+    if (typeof g.navigator?.getBattery === 'function') {
+      g.navigator
+        .getBattery()
+        .then((b: any) => {
+          const charging = () => {
+            this.battery = !b.charging;
+          };
+          charging();
+          b.addEventListener?.('chargingchange', charging);
+          this.stops.push(() => b.removeEventListener?.('chargingchange', charging));
+        })
+        .catch(() => {});
+    }
+  }
+
+  stop() {
+    this.stops.forEach((s) => s());
+    this.stops = [];
+  }
+
+  /** The next reading tells the machine again: after a join or a reconnect, to a node that may know nothing of it. */
+  tellMachineAgain() {
+    this.machineSaid = false;
+    if (this.camera) {
+      this.cameraSaid = false;
+    }
+  }
+
+  /**
+   * The product's camera report (Room.reportMeshCamera): kept as it is now, told with the next reading, and at once when
+   * it says a switch the node hasn't heard of (troubled). Trimmed to MESH_CAMERA_MAX: its oldest tests and switches go
+   * first.
+   */
+  setCamera(info: MeshCamera) {
+    const c: MeshCamera = {
+      ...info,
+      tests: info.tests?.slice(-8),
+      switches: info.switches?.slice(-4),
+    };
+    while (
+      JSON.stringify(c).length > MESH_CAMERA_MAX &&
+      ((c.tests?.length ?? 0) > 0 || (c.switches?.length ?? 0) > 0)
+    ) {
+      if ((c.tests?.length ?? 0) > 0) {
+        c.tests = c.tests!.slice(1);
+      } else {
+        c.switches = c.switches!.slice(1);
+      }
+    }
+    if (JSON.stringify(c).length > MESH_CAMERA_MAX) {
+      return;
+    }
+    const switched = (c.switches?.length ?? 0) > (this.camera?.switches?.length ?? 0);
+    this.camera = c;
+    this.cameraSaid = false;
+    this.cameraUrgent = this.cameraUrgent || switched;
+  }
+
+  private cameraUrgent = false;
+
+  pressureChanged(state: Pressure, now = Date.now()) {
+    if (!(state in PRESSURE_RANK)) {
+      return;
+    }
+    this.accountPressure(now);
+    this.c.pressure = state;
+    if (!this.c.cpu || PRESSURE_RANK[state] > PRESSURE_RANK[this.c.cpu]) {
+      this.c.cpu = state;
+    }
+  }
+
+  private accountPressure(now: number) {
+    if (this.c.pressure && PRESSURE_RANK[this.c.pressure] >= PRESSURE_RANK.serious) {
+      this.c.cpuMs += now - this.c.pressureAt;
+    }
+    this.c.pressureAt = now;
+  }
+
+  visibilityChanged(hidden: boolean, now = Date.now()) {
+    if (hidden && this.c.hiddenAt === undefined) {
+      this.c.hiddenAt = now;
+    } else if (!hidden && this.c.hiddenAt !== undefined) {
+      this.c.hiddenMs += now - this.c.hiddenAt;
+      this.c.hiddenAt = undefined;
+    }
+  }
+
+  /**
+   * Whether something since the last reading can't wait for the next: CPU under serious pressure, a hang of a second, a
+   * camera switch the node hasn't heard of.
+   */
+  troubled(): boolean {
+    return (
+      (this.c.cpu !== undefined && PRESSURE_RANK[this.c.cpu] >= PRESSURE_RANK.serious) ||
+      this.c.hangMs >= 1000 ||
+      this.c.devices > 0 ||
+      this.cameraUrgent
+    );
+  }
+
+  /**
+   * What happened since the last reading, and the counters started over; paths: each connection's shared reading by
+   * name (pub, sub). Only what there is to say: a quiet page on a fine machine says almost nothing.
+   */
+  async reading(
+    paths: Record<
+      string,
+      { forEach(fn: (s: any) => void): void; get(id: string): any } | undefined
+    >,
+    now = Date.now(),
+  ): Promise<MeshHealth> {
+    this.accountPressure(now);
+    const c = this.c;
+    const out: MeshHealth = {};
+    if (c.cpu && c.cpu !== 'nominal') {
+      out.cpu = c.cpu;
+    }
+    if (c.cpuMs > 0) {
+      out.cpuMs = c.cpuMs;
+    }
+    if (c.hangs > 0) {
+      out.hangs = c.hangs;
+      out.hangMs = c.hangMs;
+    }
+    const hiddenMs = c.hiddenMs + (c.hiddenAt !== undefined ? now - c.hiddenAt : 0);
+    if (hiddenMs > 0) {
+      out.hiddenMs = hiddenMs;
+    }
+    if (this.battery !== undefined) {
+      out.battery = this.battery;
+    }
+    if (c.devices > 0) {
+      out.devices = c.devices;
+    }
+    for (const [name, report] of Object.entries(paths)) {
+      const path = report ? this.pathOf(name, report) : undefined;
+      if (path && (name === 'pub' || name === 'sub')) {
+        out[name] = path;
+      }
+    }
+    if (!this.machineSaid) {
+      const machine = await this.machine();
+      if (machine) {
+        out.machine = machine;
+      }
+      this.machineSaid = true;
+    }
+    if (!this.cameraSaid && this.camera) {
+      out.camera = this.camera;
+    }
+    this.cameraSaid = true;
+    this.cameraUrgent = false;
+    // what carries on (a pressure state, a hidden page) starts the next reading as it is now: the state it is in is the
+    // worst of the next until another comes
+    this.c = {
+      ...fresh(),
+      cpu: c.pressure,
+      pressure: c.pressure,
+      pressureAt: now,
+      hiddenAt: c.hiddenAt !== undefined ? now : undefined,
+    };
+    return out;
+  }
+
+  /** A connection's path from its reading: the selected pair's round trip and upload estimate, and what changed. */
+  private pathOf(
+    name: string,
+    report: { forEach(fn: (s: any) => void): void; get(id: string): any },
+  ): MeshPathHealth | undefined {
+    let transport: any;
+    report.forEach((s) => {
+      if (s?.type === 'transport' && s.selectedCandidatePairId && !transport) {
+        transport = s;
+      }
+    });
+    const pair = transport ? report.get(transport.selectedCandidatePairId) : undefined;
+    if (!pair) {
+      return undefined;
+    }
+    const num = (v: unknown) => (typeof v === 'number' && Number.isFinite(v) ? v : undefined);
+    const now: PathTotals = {
+      sendFailed: num(pair.packetsDiscardedOnSend),
+      asked: num(pair.consentRequestsSent) ?? num(pair.requestsSent),
+      answered: num(pair.responsesReceived),
+      switched: num(transport.selectedCandidatePairChanges),
+    };
+    const prev = this.paths.get(name);
+    this.paths.set(name, now);
+    const delta = (a?: number, b?: number) =>
+      a !== undefined && b !== undefined && b >= a ? b - a : undefined;
+    const out: MeshPathHealth = {};
+    const rtt = num(pair.currentRoundTripTime);
+    if (rtt !== undefined) {
+      out.rtt = Math.round(rtt * 1000);
+    }
+    const outBps = num(pair.availableOutgoingBitrate);
+    if (outBps !== undefined) {
+      out.outKbps = Math.round(outBps / 1000);
+    }
+    if (prev) {
+      const failed = delta(prev.sendFailed, now.sendFailed);
+      if (failed) {
+        out.sendFailed = failed;
+      }
+      const asked = delta(prev.asked, now.asked);
+      const answered = delta(prev.answered, now.answered);
+      if (asked !== undefined && answered !== undefined && asked > answered) {
+        out.unanswered = asked - answered;
+      }
+      const switched = delta(prev.switched, now.switched);
+      if (switched) {
+        out.switched = switched;
+      }
+    }
+    return out;
+  }
+
+  /** The machine: its cores and memory as the browser rounds them, and its graphics adapter where WebGPU names it. */
+  private async machine(): Promise<MeshHealth['machine'] | undefined> {
+    const nav = (globalThis as any).navigator;
+    if (!nav) {
+      return undefined;
+    }
+    const out: NonNullable<MeshHealth['machine']> = {};
+    if (typeof nav.hardwareConcurrency === 'number') {
+      out.cores = nav.hardwareConcurrency;
+    }
+    if (typeof nav.deviceMemory === 'number') {
+      out.memGb = nav.deviceMemory;
+    }
+    const gpu = await MeshHealthWatch.gpuName(nav);
+    if (gpu) {
+      out.gpu = gpu;
+    }
+    return Object.keys(out).length ? out : undefined;
+  }
+
+  /**
+   * The graphics adapter's vendor and architecture (WebGPU's adapter info), once a page and at most 300 ms: a low-power
+   * adapter asked for, so a laptop's second GPU isn't woken for it.
+   */
+  private static gpuName(nav: any): Promise<string | undefined> {
+    if (!MeshHealthWatch.gpu) {
+      const ask = async (): Promise<string | undefined> => {
+        if (!nav.gpu || typeof nav.gpu.requestAdapter !== 'function') {
+          return undefined;
+        }
+        const adapter = await nav.gpu.requestAdapter({ powerPreference: 'low-power' });
+        const info = adapter?.info;
+        const name = [info?.vendor, info?.architecture]
+          .filter((s: unknown) => typeof s === 'string' && s)
+          .join(' ');
+        return name ? name.slice(0, 60) : undefined;
+      };
+      MeshHealthWatch.gpu = Promise.race([
+        ask().catch(() => undefined),
+        new Promise<undefined>((resolve) => setTimeout(() => resolve(undefined), 300)),
+      ]);
+    }
+    return MeshHealthWatch.gpu;
+  }
+}
