+            pub.trackSid,
+            kind,
+            this.meshReceiverTotals.get(receiver),
+            now,
+            kind === 'video' ? receiverHeight(report) : undefined,
+            onAt !== this.meshReceiverResumes.get(receiver) ? onAt : undefined,
+          );
+          this.meshReceiverTotals.set(receiver, now);
+          if (read?.hiddenGaps && onAt !== undefined) {
+            this.meshReceiverResumes.set(receiver, onAt);
+          }
+          if (read) {
+            tracks.push(read);
+          }
+        } catch {
+          // a receiver gone while it was read
+        }
+      }
+    }
+    return tracks;
+  };
