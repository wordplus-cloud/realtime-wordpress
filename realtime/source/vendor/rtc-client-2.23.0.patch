+/**
+ * WordPlus Mesh (rtc-client 1.0.10): which encoder each published video runs on, hardware or software, told to the
+ * node for its live view (2026-10-18), so a call's people show whether each browser publishes in hardware or in
+ * software. Only the browser knows it, in its senders' stats: `encoderImplementation`, which Chrome gives as
+ * "SimulcastEncoderAdapter (OpenH264, VideoToolbox, VideoToolbox)" for a camera's three layers, one encoder a layer
+ * from the smallest up, and `powerEfficientEncoder`. Both are shown only to a page that captures, as a call does.
+ * Firefox and Safari give neither.
+ *
+ * 1.0.11: each layer's encode time a frame, key frames made and key frames asked for (PLI, FIR) since the last
+ * reading, the capture's mode (its size and the frames a second it was opened at), and a browser that names no
+ * encoder still tells its layers' frames and size (2026-10-19: a call where many people sent few frames a second,
+ * one of them a Windows PC that encoded 3-7 of the 14 frames its camera gave, its 360p some 100 kbit a
+ * frame: an encoder too slow and a storm of key frames look alike without them, as a dim room and a camera that
+ * opens 1080p at 15 frames do without its mode).
+ *
+ * Read every REPORT_EVERY_MS while connected and sent when it changed, and again after a reconnect, in a signal
+ * request with no message of LiveKit's and the JSON in MESH_ENCODERS_FIELD: a node before 1.0.35 handles it as
+ * nothing. Only to the mesh's servers.
+ */
+import type { MeshEncoderLayer, MeshEncoderTrack, MeshSending } from '../api/utils';
+import { sharedSenderStats } from './meshStats';
+import type LocalVideoTrack from './track/LocalVideoTrack';
+
+export const REPORT_EVERY_MS = 10_000;
+
+/** Encoders that run on the CPU, by the name the browser gives; any other a browser names is a device's. */
+const SOFTWARE = /^(libvpx|openh264|libaom|svt|ffmpeg|libx26|dav1d|rav1e|fake)/i;
+
+/** Whether an encoder named so runs in hardware: null when the browser named none. */
+export function encoderHardware(
+  name: string | undefined,
+  powerEfficient?: boolean,
+): boolean | null {
+  if (!name) {
+    return typeof powerEfficient === 'boolean' ? powerEfficient : null;
+  }
+  return !SOFTWARE.test(name.trim());
+}
+
+/** The encoders a SimulcastEncoderAdapter names, in its streams' order; the name itself for any other. */
+export function adapterEncoders(name: string): string[] {
+  const m = /^SimulcastEncoderAdapter\s*\((.*)\)\s*$/.exec(name.trim());
+  return m
+    ? m[1]
+        .split(',')
+        .map((s) => s.trim())
+        .filter(Boolean)
+    : [name.trim()];
+}
+
+const RID_ORDER = ['q', 'h', 'f'];
+
+type Outbound = {
+  rid: string;
+  height: number;
+  encoder?: string;
+  powerEfficient?: boolean;
+  active: boolean;
+  /** frames a second it encodes now; undefined where the browser doesn't say */
+  fps?: number;
+  /** what holds its quality back: "cpu", "bandwidth", "other", "none" (qualityLimitationReason) */
+  limit?: string;
+  /** frames a second its source (the camera, the screen capture) gives the encoder */
+  captured?: number;
+  mime: string;
+  /** since the sender's last reading (sinceLast): ms of encoding a frame, key frames made, key frames asked for */
+  encodeMs?: number;
+  keyFrames?: number;
+  plis?: number;
+  /** the bitrate its encoder aims at now, bit/s (1.0.16) */
+  target?: number;
+} & Sent;
+
+/** What a layer sent between two readings (1.0.16, sinceLast), which its codec's sending sums (sendingOf). */
+type Sent = {
+  encoded?: number;
+  sent?: number;
+  packets?: number;
+  /** s its packets waited in the sending queue, summed */
+  sendDelay?: number;
+  resent?: number;
+  huge?: number;
+  /** s its encoder was held back, by what */
+  limits?: { cpu?: number; bandwidth?: number; other?: number };
+  /** frames its source gave (the media-source's own total) */
+  sourceFrames?: number;
+};
+
+/** A layer's running totals in its stats, from which sinceLast takes what changed between two readings. */
+export type Totals = {
+  encodeTime?: number;
+  frames?: number;
+  keyFrames?: number;
+  plis?: number;
+  /** 1.0.16: framesSent, packetsSent, totalPacketSendDelay, retransmittedPacketsSent, hugeFramesSent,
+   * qualityLimitationDurations, and its media source's frames */
+  sent?: number;
+  packets?: number;
+  sendDelay?: number;
+  resent?: number;
+  huge?: number;
+  limits?: Record<string, number>;
+  sourceFrames?: number;
+};
+
+/**
+ * What a layer did between two readings of its totals: the time it took to encode a frame, in ms, and the key frames
+ * it made and was asked for (PLI and FIR); and (1.0.16) the frames it encoded and sent, its packets, how long they
+ * waited to go, those sent again, its oversized frames, how long its encoder was held back and by what, and the frames
+ * its source gave. Nothing from a first reading, nor from a total the browser doesn't keep or that went back (a sender
+ * started over).
+ */
+export function sinceLast(
+  prev: Totals | undefined,
+  now: Totals,
+): { encodeMs?: number; keyFrames?: number; plis?: number } & Sent {
+  const out: { encodeMs?: number; keyFrames?: number; plis?: number } & Sent = {};
+  if (!prev) {
+    return out;
+  }
+  const delta = (a?: number, b?: number) =>
+    typeof a === 'number' && typeof b === 'number' && b >= a ? b - a : undefined;
+  const frames = delta(prev.frames, now.frames);
+  const time = delta(prev.encodeTime, now.encodeTime);
+  if (frames && time !== undefined) {
+    out.encodeMs = Math.round((time / frames) * 10_000) / 10;
+  }
+  const keyFrames = delta(prev.keyFrames, now.keyFrames);
+  if (keyFrames !== undefined) {
+    out.keyFrames = keyFrames;
+  }
+  const plis = delta(prev.plis, now.plis);
+  if (plis !== undefined) {
+    out.plis = plis;
+  }
+  const put = <K extends keyof Sent>(k: K, v: Sent[K] | undefined) => {
+    if (v !== undefined) {
+      out[k] = v;
+    }
+  };
+  put('encoded', frames);
+  put('sent', delta(prev.sent, now.sent));
+  put('packets', delta(prev.packets, now.packets));
+  put('sendDelay', delta(prev.sendDelay, now.sendDelay));
+  put('resent', delta(prev.resent, now.resent));
+  put('huge', delta(prev.huge, now.huge));
+  put('sourceFrames', delta(prev.sourceFrames, now.sourceFrames));
+  if (prev.limits && now.limits) {
+    const limits: NonNullable<Sent['limits']> = {};
+    for (const k of ['cpu', 'bandwidth', 'other'] as const) {
+      const d = delta(prev.limits[k], now.limits[k]);
+      if (d) {
+        limits[k] = d;
+      }
+    }
+    out.limits = limits;
+  }
+  return out;
+}
+
+/**
+ * What a codec's sending did since the last reading, its layers summed (1.0.16): the frames its source gave, the ms
+ * its encoder was held back by each cause (the layer held back most: they share one encoder's adapter), the ms a packet
+ * waited to go on average, the share sent again (%) and its oversized frames. Each only where there is something.
+ */
+export function sendingOf(outbound: Sent[]): MeshSending {
+  const out: MeshSending = {};
+  let packets = 0;
+  let delay = 0;
+  let resent = 0;
+  let huge = 0;
+  let frames: number | undefined;
+  const held: NonNullable<MeshSending['limitMs']> = {};
+  for (const o of outbound) {
+    packets += o.packets ?? 0;
+    delay += o.sendDelay ?? 0;
+    resent += o.resent ?? 0;
+    huge += o.huge ?? 0;
+    if (o.sourceFrames !== undefined) {
+      frames = Math.max(frames ?? 0, o.sourceFrames);
+    }
+    for (const k of ['cpu', 'bandwidth', 'other'] as const) {
+      const ms = Math.round((o.limits?.[k] ?? 0) * 1000);
+      if (ms > (held[k] ?? 0)) {
+        held[k] = ms;
+      }
+    }
+  }
+  if (frames !== undefined) {
+    out.frames = frames;
+  }
+  if (Object.keys(held).length) {
+    out.limitMs = held;
+  }
+  if (packets > 0) {
+    out.queueMs = Math.round((delay * 10_000) / packets) / 10;
+    if (resent > 0) {
+      out.resent = Math.round((resent * 1000) / packets) / 10;
+    }
+  }
+  if (huge > 0) {
+    out.huge = huge;
+  }
+  return out;
+}
+
+/** Each sender's layers' totals at its last reading, by rid. */
+const lastTotals = new WeakMap<RTCRtpSender, Map<string, Totals>>();
+
+/**
+ * Whether a layer encodes now: Chrome's adapter names the encoders of those alone, and a layer the server paused
+ * (dynacast) can still read active for a moment after it stopped, so its frames decide where it says them.
+ */
+const sending = (o: Outbound) => o.active && (o.fps === undefined || o.fps > 0);
+
+/**
+ * One sender's layers, each with its own encoder where the adapter's list matches the layers that encode, or the one
+ * encoder every one of them runs on; a browser that names none (Firefox, Safari) still gets its layers' frames and
+ * size told, its encoder "".
+ */
+export function layersOf(
+  outbound: Outbound[],
+): { encoder: string; layers: MeshEncoderLayer[] } | undefined {
+  if (!outbound.length) {
+    return undefined;
+  }
+  const named = outbound.find((o) => o.encoder);
+  const order = (o: Outbound) => {
+    const i = RID_ORDER.indexOf(o.rid);
+    return i < 0 ? RID_ORDER.length + o.height : i;
+  };
+  const sorted = [...outbound].sort((a, b) => order(a) - order(b) || a.height - b.height);
+  const list = named?.encoder ? adapterEncoders(named.encoder) : [];
+  const active = sorted.filter(sending);
+  const one = list.length > 0 && new Set(list).size === 1;
+  const layers = sorted.map((o): MeshEncoderLayer => {
+    let encoder: string | undefined;
+    if (one) {
+      encoder = list[0];
+    } else if (list.length && list.length === active.length && sending(o)) {
+      encoder = list[active.indexOf(o)];
+    } else if (list.length && list.length === sorted.length) {
+      encoder = list[sorted.indexOf(o)];
+    }
+    const layer: MeshEncoderLayer = { rid: o.rid };
+    if (encoder) {
+      layer.encoder = encoder.slice(0, 80);
+      const hw = encoderHardware(encoder, list.length === 1 ? o.powerEfficient : undefined);
+      if (hw !== null) {
+        layer.hw = hw;
+      }
+    }
+    // what it encodes now, and what holds it back: Chrome lowers a layer's frames and size for its CPU or its upload
+    // (a Windows PC's 2560×1440 share in VP8 went out at 1-1.4 Mbit/s of an estimated 5, 2026-10-18)
+    if (sending(o) && o.fps !== undefined) {
+      layer.fps = Math.round(o.fps);
+      if (o.height) {
+        layer.height = o.height;
+      }
+      if (o.limit && o.limit !== 'none') {
+        layer.limit = o.limit;
+      }
+      // how it encodes: ms a frame, and key frames made and asked for since the last reading, which a slow encoder
+      // and a storm of key frames tell apart
+      if (o.encodeMs !== undefined) {
+        layer.encodeMs = o.encodeMs;
+      }
+      if (o.keyFrames !== undefined) {
+        layer.keyFrames = o.keyFrames;
+      }
+      if (o.plis !== undefined) {
+        layer.plis = o.plis;
+      }
+      // 1.0.16: frames encoded and sent since the last reading (fewer sent: its queue held them) and what it aims at
+      if (o.encoded !== undefined) {
+        layer.encoded = o.encoded;
+      }
+      if (o.sent !== undefined) {
+        layer.sent = o.sent;
+      }
+      if (o.target) {
+        layer.target = Math.round(o.target / 1000);
+      }
+    }
+    return layer;
+  });
+  return { encoder: named?.encoder?.slice(0, 200) ?? '', layers };
+}
+
+async function outboundOf(sender: RTCRtpSender | undefined): Promise<Outbound[]> {
+  if (!sender) {
+    return [];
+  }
+  const out: Outbound[] = [];
+  // 1.0.16: its part of the connection's shared reading (meshStats.ts)
+  const stats = await sharedSenderStats(sender);
+  const before = lastTotals.get(sender);
+  const totals = new Map<string, Totals>();
+  const num = (v: unknown) => (typeof v === 'number' ? v : undefined);
+  stats.forEach((s) => {
+    if (s.type !== 'outbound-rtp' || s.kind !== 'video') {
+      return;
+    }
+    const codec = s.codecId ? stats.get(s.codecId) : undefined;
+    const source = s.mediaSourceId ? stats.get(s.mediaSourceId) : undefined;
+    const rid = typeof s.rid === 'string' ? s.rid : '';
+    const now: Totals = {
+      encodeTime: num(s.totalEncodeTime),
+      frames: num(s.framesEncoded),
+      keyFrames: num(s.keyFramesEncoded),
+      plis:
+        num(s.pliCount) !== undefined || num(s.firCount) !== undefined
+          ? (num(s.pliCount) ?? 0) + (num(s.firCount) ?? 0)
+          : undefined,
+      sent: num(s.framesSent),
+      packets: num(s.packetsSent),
+      sendDelay: num(s.totalPacketSendDelay),
+      resent: num(s.retransmittedPacketsSent),
+      huge: num(s.hugeFramesSent),
+      limits:
+        s.qualityLimitationDurations && typeof s.qualityLimitationDurations === 'object'
+          ? { ...s.qualityLimitationDurations }
+          : undefined,
+      sourceFrames: num(source?.frames),
+    };
+    totals.set(rid, now);
+    out.push({
+      ...sinceLast(before?.get(rid), now),
+      target: num(s.targetBitrate),
+      captured: typeof source?.framesPerSecond === 'number' ? source.framesPerSecond : undefined,
+      rid,
+      height: s.frameHeight ?? 0,
+      encoder: typeof s.encoderImplementation === 'string' ? s.encoderImplementation : undefined,
+      powerEfficient:
+        typeof s.powerEfficientEncoder === 'boolean' ? s.powerEfficientEncoder : undefined,
+      active: s.active !== false,
+      fps: typeof s.framesPerSecond === 'number' ? s.framesPerSecond : undefined,
+      limit: typeof s.qualityLimitationReason === 'string' ? s.qualityLimitationReason : undefined,
+      mime: typeof codec?.mimeType === 'string' ? codec.mimeType : '',
+    });
+  });
+  lastTotals.set(sender, totals);
+  return out;
+}
+
+/**
+ * The mode the browser opened its capture at: the size and the frames a second it asked the device for (its
+ * settings), apart from the frames the device gives (captured). A camera opened at 30 that gives 15 is in a dim room;
+ * one opened at 15 can do no more at that size.
+ */
+export function captureMode(track: MediaStreamTrack | undefined): MeshEncoderTrack['mode'] {
+  try {
+    const s = track?.getSettings();
+    if (s && typeof s.width === 'number' && typeof s.height === 'number') {
+      return {
+        width: s.width,
+        height: s.height,
+        ...(typeof s.frameRate === 'number' ? { fps: Math.round(s.frameRate) } : {}),
+      };
+    }
+  } catch {
+    // a track ended while it was read
+  }
+  return undefined;
+}
+
+/** What one published video's encoders are: its own codec's, and its backup's when that sends. */
+export async function readTrackEncoders(
+  sid: string,
+  track: LocalVideoTrack,
+): Promise<MeshEncoderTrack | undefined> {
+  const senders: [RTCRtpSender | undefined, string | undefined][] = [[track.sender, undefined]];
+  for (const [codec, info] of track.simulcastCodecs) {
+    senders.push([info.sender, codec]);
+  }
+  const codecs: MeshEncoderTrack['codecs'] = [];
+  for (const [sender, named] of senders) {
+    let outbound: Outbound[];
+    try {
+      outbound = await outboundOf(sender);
+    } catch {
+      continue;
+    }
+    const read = layersOf(outbound);
+    if (!read) {
+      continue;
+    }
+    const mime = outbound.find((o) => o.mime)?.mime ?? '';
+    const codec = (named ?? mime.replace(/^video\//i, '')).toLowerCase();
+    // the frames a second the source gives the encoder (its media-source stats): a capture that gives few itself
+    // and an encoder that drops what it is given look alike from the layers alone
+    const captured = Math.max(...outbound.map((o) => o.captured ?? -1));
+    codecs.push({
+      codec,
+      encoder: read.encoder,
+      layers: read.layers,
+      ...(captured >= 0 ? { captured: Math.round(captured) } : {}),
+      // 1.0.16: what its sending did since the last reading (sendingOf)
+      ...sendingOf(outbound),
+    });
+  }
+  if (!codecs.length) {
+    return undefined;
+  }
+  const mode = captureMode(track.mediaStreamTrack);
+  const out: MeshEncoderTrack = mode ? { sid, codecs, mode } : { sid, codecs };
+  // 1.0.16: its source stopping by itself since the last reading (watchSource)
+  const stalled = sourceStalls(track.mediaStreamTrack);
+  if (stalled.stalls || stalled.ms) {
+    out.stalls = stalled.stalls;
+    out.stallMs = stalled.ms;
+  }
+  return out;
+}
+
+/** A source's own stops: its track's mute and unmute events, counted as they come (no timer). */
+type SourceWatch = { stalls: number; ms: number; mutedAt?: number };
+const sources = new WeakMap<MediaStreamTrack, SourceWatch>();
+
+/** Whether a published track's source stopped by itself since its last reading, or is stopped now (no reading taken). */
+export function sourceStalled(track: MediaStreamTrack | undefined): boolean {
+  const w = track ? sources.get(track) : undefined;
+  return !!w && (w.stalls > 0 || w.mutedAt !== undefined);
+}
+
+/**
+ * The times a published track's source stopped giving frames by itself since the last time asked, and the ms it gave
+ * none (1.0.16). A MediaStreamTrack is muted when its source delivers nothing: the camera, its driver or the system
+ * holding it, as a PC that hangs does, never the person (that is `enabled`). The first ask starts the watch.
+ */
+export function sourceStalls(track: MediaStreamTrack | undefined): { stalls: number; ms: number } {
+  if (!track || typeof track.addEventListener !== 'function') {
+    return { stalls: 0, ms: 0 };
+  }
+  let w = sources.get(track);
+  if (!w) {
+    const watch: SourceWatch = { stalls: 0, ms: 0, mutedAt: track.muted ? Date.now() : undefined };
+    track.addEventListener('mute', () => {
+      watch.stalls++;
+      watch.mutedAt = Date.now();
+    });
+    track.addEventListener('unmute', () => {
+      if (watch.mutedAt !== undefined) {
+        watch.ms += Date.now() - watch.mutedAt;
+        watch.mutedAt = undefined;
+      }
+    });
+    sources.set(track, watch);
+    w = watch;
+  }
+  // one still muted counts its time so far, the rest in the next
+  const now = Date.now();
+  const ms = w.ms + (w.mutedAt !== undefined ? now - w.mutedAt : 0);
+  const out = { stalls: w.stalls, ms };
+  w.stalls = 0;
+  w.ms = 0;
+  if (w.mutedAt !== undefined) {
+    w.mutedAt = now;
+  }
+  return out;
+}
