+      }
+    }
+    // a freeze in what it plays, from the subscriber's shared reading (a read at most once a round)
+    const sub = this.engine?.pcManager?.subscriber ?? this.engine?.pcManager?.publisher;
+    const reading = sub ? this.meshStats.read(sub) : undefined;
