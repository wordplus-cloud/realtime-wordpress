+  private readMeshReceivers = async (): Promise<MeshReceiverTrack[]> => {
+    const tracks: MeshReceiverTrack[] = [];
+    for (const participant of this.remoteParticipants.values()) {
+      for (const pub of participant.trackPublications.values()) {
+        const track = pub.track;
+        const receiver = track?.receiver;
+        if (!track || !receiver || !pub.trackSid) {
+          continue;
+        }
+        try {
+          // 1.0.16: its part of the connection's shared reading (meshStats.ts)
+          const report = await sharedReceiverStats(receiver);
+          const now = receiverTotals(report);
+          if (!now) {
+            continue;
+          }
+          const kind = track.kind === Track.Kind.Video ? 'video' : 'audio';
+          // 1.0.17: when this client last turned it back on itself, unless a reading told that gap already
+          const onAt = pub.meshOnAt;
