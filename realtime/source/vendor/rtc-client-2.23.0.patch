index 0000000..01894aa
--- /dev/null
+++ b/src/room/meshStats.test.ts
@@ -0,0 +1,162 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { MeshStatsHub, READ_EVERY_MS, withReferences } from './meshStats';
+
+/** A connection's reading: two received tracks (a camera and a microphone) and a camera sent in two layers. */
+function reading() {
+  const entries: any[] = [
+    {
+      id: 'IT01',
+      type: 'inbound-rtp',
+      kind: 'video',
+      trackIdentifier: 'cam-a',
+      codecId: 'C1',
+      transportId: 'T',
+      bytesReceived: 1000,
+      timestamp: 1,
+    },
+    {
+      id: 'IT02',
+      type: 'inbound-rtp',
+      kind: 'audio',
+      trackIdentifier: 'mic-a',
+      codecId: 'C2',
+      transportId: 'T',
+      bytesReceived: 50,
+      timestamp: 1,
+    },
+    {
+      id: 'OT01',
+      type: 'outbound-rtp',
+      kind: 'video',
+      mid: '0',
+      rid: 'q',
+      mediaSourceId: 'S1',
+      codecId: 'C1',
+      remoteId: 'RI1',
+    },
+    {
+      id: 'OT02',
+      type: 'outbound-rtp',
+      kind: 'video',
+      mid: '0',
+      rid: 'h',
+      mediaSourceId: 'S1',
+      codecId: 'C1',
+    },
+    {
+      id: 'OT03',
+      type: 'outbound-rtp',
+      kind: 'video',
+      mid: '2',
+      rid: 'q',
+      mediaSourceId: 'S1',
+      codecId: 'C3',
+    },
+    { id: 'S1', type: 'media-source', kind: 'video', trackIdentifier: 'my-cam' },
+    { id: 'RI1', type: 'remote-inbound-rtp', roundTripTime: 0.02 },
+    { id: 'C1', type: 'codec', mimeType: 'video/H264' },
+    { id: 'C2', type: 'codec', mimeType: 'audio/opus' },
+    { id: 'C3', type: 'codec', mimeType: 'video/VP8' },
+    { id: 'T', type: 'transport', selectedCandidatePairId: 'P' },
+    { id: 'P', type: 'candidate-pair', localCandidateId: 'L', remoteCandidateId: 'R' },
+    { id: 'L', type: 'local-candidate' },
+    { id: 'R', type: 'remote-candidate' },
+    { id: 'X', type: 'certificate' },
+  ];
+  return new Map(entries.map((e) => [e.id, e]));
+}
+
+function connection() {
+  const camReceiver = { track: { id: 'cam-a' } } as unknown as RTCRtpReceiver;
+  const micReceiver = { track: { id: 'mic-a' } } as unknown as RTCRtpReceiver;
+  const camSender = { track: { id: 'my-cam' } } as unknown as RTCRtpSender;
+  const backupSender = { track: { id: 'my-cam' } } as unknown as RTCRtpSender;
+  const getStats = vi.fn(async () => reading() as unknown as RTCStatsReport);
+  const pc = {
+    getStats,
+    getTransceivers: () =>
+      [
+        { mid: '0', sender: camSender, receiver: {} },
+        { mid: '1', sender: {}, receiver: camReceiver },
+        { mid: '2', sender: backupSender, receiver: {} },
+        { mid: '3', sender: {}, receiver: micReceiver },
+      ] as unknown as RTCRtpTransceiver[],
+    getSenders: () => [camSender, backupSender],
+  };
+  return { pc, getStats, camReceiver, micReceiver, camSender, backupSender };
+}
+
+describe('meshStats', () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('gives each received track its own entries and what they refer to', async () => {
+    const c = connection();
+    const hub = new MeshStatsHub();
+    hub.open(() => [c.pc, undefined]);
+    const cam = await hub.forReceiver(c.camReceiver);
+    expect([...cam!.keys()].sort()).toEqual(['C1', 'IT01', 'L', 'P', 'R', 'T']);
+    const mic = await hub.forReceiver(c.micReceiver);
+    expect(mic!.get('IT02').bytesReceived).toBe(50);
+    expect(mic!.has('IT01')).toBe(false);
+    hub.close();
+  });
+
+  it('tells a sender from another sending the same track by its mid', async () => {
+    const c = connection();
+    const hub = new MeshStatsHub();
+    hub.open(() => [c.pc]);
+    const own = await hub.forSender(c.camSender);
+    const outbound = [...own!.values()].filter((s) => s.type === 'outbound-rtp').map((s) => s.id);
+    expect(outbound).toEqual(['OT01', 'OT02']);
+    // its media source and the far end's report come with it, as a sender's own reading has them
+    expect(own!.has('S1') && own!.has('RI1')).toBe(true);
+    const backup = await hub.forSender(c.backupSender);
+    expect([...backup!.values()].filter((s) => s.type === 'outbound-rtp').map((s) => s.id)).toEqual(
+      ['OT03'],
+    );
+    hub.close();
+  });
+
+  it('reads a connection once however many ask within a round, and again after it', async () => {
+    vi.useFakeTimers();
+    const c = connection();
+    const hub = new MeshStatsHub();
+    hub.open(() => [c.pc]);
+    await Promise.all([
+      hub.forReceiver(c.camReceiver),
+      hub.forReceiver(c.micReceiver),
+      hub.forSender(c.camSender),
+    ]);
+    expect(c.getStats).toHaveBeenCalledTimes(1);
+    vi.advanceTimersByTime(READ_EVERY_MS - 100);
+    await hub.forReceiver(c.camReceiver);
+    expect(c.getStats).toHaveBeenCalledTimes(1);
+    vi.advanceTimersByTime(200);
+    await hub.forReceiver(c.camReceiver);
+    expect(c.getStats).toHaveBeenCalledTimes(2);
+    expect(hub.reads).toBe(2);
+    hub.close();
+  });
+
+  it('holds nothing it was not given, nor anything once closed', async () => {
+    const c = connection();
+    const hub = new MeshStatsHub();
+    expect(await hub.forReceiver(c.camReceiver)).toBeUndefined();
+    hub.open(() => [c.pc]);
+    // a track the reading doesn't name
+    expect(
+      await hub.forReceiver({ track: { id: 'gone' } } as unknown as RTCRtpReceiver),
+    ).toBeUndefined();
+    hub.close();
+    expect(await hub.forReceiver(c.camReceiver)).toBeUndefined();
+  });
+
+  it('follows references transitively and skips what is missing', () => {
+    const full = reading();
+    const out = withReferences(full, [full.get('OT01')]);
+    expect([...out.keys()].sort()).toEqual(['C1', 'OT01', 'RI1', 'S1']);
+    expect(withReferences(full, [{ id: 'Z', type: 'inbound-rtp', codecId: 'none' }]).size).toBe(1);
+  });
+});
diff --git a/src/room/meshStats.ts b/src/room/meshStats.ts
