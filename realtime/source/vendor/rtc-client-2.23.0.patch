+        'video',
+        before,
+        totals(20_000, {
+          framesDecoded: 300 + 206,
+          totalInterFrameDelay: 10 + 1.8 + 205 * 0.04,
+          totalSquaredInterFrameDelay: 0.5 + 1.8 * 1.8 + 205 * 0.0016,
+          pauseCount: 0,
+          totalPausesDuration: 0,
+          freezeCount: 1,
+          totalFreezesDuration: 1.8,
+        }),
+        720,
+        18_000,
+      )!;
+      expect(read).toMatchObject({
+        hiddenGaps: 1,
+        hiddenGapMs: 1800,
+        freezes: 0,
+        freezeMs: 0,
+        unevenMs: 0,
+      });
+    });
+
+    it("leaves the spread unsaid when the gap's length isn't known", () => {
+      // two pauses: which gaps they were the totals can't say
+      const two = receiverReading(
+        'TR_v',
+        'video',
+        before,
+        totals(20_000, {
+          framesDecoded: 320,
+          totalInterFrameDelay: 10 + 9.5,
+          totalSquaredInterFrameDelay: 0.5 + 4 * 4 + 5 * 5 + 0.1,
+          pauseCount: 2,
+          totalPausesDuration: 9,
+          freezeCount: 0,
+          totalFreezesDuration: 0,
+        }),
+        720,
+        18_000,
+      )!;
+      expect(two).toMatchObject({ hiddenGaps: 2, hiddenGapMs: 9000 });
+      expect(two.pauses).toBeUndefined();
+      expect(two.unevenMs).toBeUndefined();
+      // a browser that counts no pauses or freezes (Firefox, Safari)
+      const ff = receiverReading(
+        'TR_v',
+        'video',
+        totals(10_000, {
+          framesDecoded: 300,
+          totalInterFrameDelay: 10,
+          totalSquaredInterFrameDelay: 0.5,
+        }),
+        totals(20_000, {
+          framesDecoded: 351,
+          totalInterFrameDelay: 28.1,
+          totalSquaredInterFrameDelay: 0.5 + 16.1 * 16.1 + 0.085,
+        }),
+        720,
+        18_000,
+      )!;
+      expect(ff.unevenMs).toBeUndefined();
+      expect(ff.hiddenGaps).toBeUndefined();
+      expect(ff.fps).toBe(5.1);
+    });
+
+    it('keeps when the client turned a video off and back on', () => {
+      const pub = new RemoteTrackPublication(
+        Track.Kind.Video,
+        new TrackInfo({ sid: 'TR_v', type: TrackType.VIDEO, name: 'camera' }),
+        true,
+      );
+      const turn = (off: boolean) => {
+        (pub as unknown as { requestedDisabled: boolean }).requestedDisabled = off;
+        pub.emitTrackUpdate();
+      };
+      turn(false);
+      expect(pub.meshOffAt).toBeUndefined();
+      expect(pub.meshOnAt).toBeUndefined();
+      turn(true);
+      const off = pub.meshOffAt!;
+      expect(off).toBeGreaterThan(0);
+      // a dimension change while off isn't a new turn-off
+      turn(true);
+      expect(pub.meshOffAt).toBe(off);
+      turn(false);
+      expect(pub.meshOffAt).toBeUndefined();
+      expect(pub.meshOnAt).toBeGreaterThanOrEqual(off);
+    });
+  });
+
+  it("goes in a signal request field of its own, beside LiveKit's", () => {
+    const req = new SignalRequest({});
+    const body = JSON.stringify({ tracks: [{ sid: 'TR_v', kind: 'video', fps: 30 }] });
+    req
+      .getType()
+      .runtime.bin.onUnknownField(
+        req,
+        MESH_RECEIVERS_FIELD,
+        2,
+        lengthDelimited(new TextEncoder().encode(body)),
+      );
+    const back = SignalRequest.fromBinary(req.toBinary());
+    const field = back
+      .getType()
+      .runtime.bin.listUnknownFields(back)
+      .find((f) => f.no === MESH_RECEIVERS_FIELD);
+    expect(field).toBeDefined();
+    expect(new TextDecoder().decode(field!.data)).toContain('"fps":30');
+  });
+});
diff --git a/src/room/meshReceivers.ts b/src/room/meshReceivers.ts
new file mode 100644
index 0000000..76bebea
--- /dev/null
+++ b/src/room/meshReceivers.ts
@@ -0,0 +1,244 @@
+/**
+ * WordPlus Mesh (rtc-client 1.0.15): what each received track is like where it plays, told to the node for its live
+ * view, so a call's quality can be followed without anyone watching it. The node knows what it sends a viewer; only
+ * the browser knows whether the picture freezes, how many frames it shows and whether the sound breaks up, in its
+ * receivers' stats: framesDecoded, frameHeight, freezeCount and totalFreezesDuration (Chrome), framesDropped,
+ * concealedSamples less silentConcealedSamples over totalSamplesReceived, packetsLost, and jitterBufferDelay over
+ * jitterBufferEmittedCount. Numbers only.
+ *
+ * Read every REPORT_EVERY_MS with the encoders (room/meshEncoders.ts), each reading what changed since the one before,
+ * and sent in a signal request with no message of LiveKit's and the JSON in MESH_RECEIVERS_FIELD: a node before
+ * 1.0.46 handles it as nothing. Only to the mesh's servers.
+ */
+import type { MeshReceiverTrack } from '../api/utils';
+
+/** A received track's running totals in its inbound-rtp stats, from which receiverReading takes what changed. */
+export type ReceiverTotals = {
+  at: number;
+  packets: number;
+  lost: number;
+  frames?: number;
+  freezes?: number;
+  freezeSeconds?: number;
+  dropped?: number;
+  samples?: number;
+  concealed?: number;
+  jitterDelay?: number;
+  jitterEmitted?: number;
+  /** 1.0.16: totalDecodeTime, the gaps between frames shown (their sum and sum of squares, s), pauses (5 s or more),
+   * key frames and retransmissions asked for, samples stretched and squeezed; and two that aren't totals: the
+   * network's jitter now (s) and whether the decoder is the device's (powerEfficientDecoder) */
+  decodeTime?: number;
+  gaps?: number;
+  gapsSquared?: number;
+  pauses?: number;
+  pauseSeconds?: number;
+  plis?: number;
+  nacks?: number;
+  stretched?: number;
+  jitter?: number;
+  hwDec?: boolean;
+  /** 1.0.17: this client's clock at the reading (Date.now()), the one it turns tracks off and on by */
+  readAt?: number;
+};
+
+/**
+ * 1.0.17: how long after this client turns a video back on its first frame may still come, ending the gap it made:
+ * the node resumes it and its sender sends a key frame. A frame landing after a reading is the next reading's.
+ */
+export const RESUME_MS = 3000;
+
+type StatsLike = { forEach(fn: (s: any) => void): void };
+
+const num = (v: unknown): number | undefined =>
+  typeof v === 'number' && Number.isFinite(v) ? v : undefined;
+const round1 = (v: number) => Math.round(v * 10) / 10;
+
+/** A receiver's totals from its stats (its own getStats(): one inbound-rtp), undefined where it has none yet. */
+export function receiverTotals(report: StatsLike): ReceiverTotals | undefined {
+  let out: ReceiverTotals | undefined;
+  report.forEach((s) => {
+    if (s?.type !== 'inbound-rtp' || out) {
+      return;
+    }
+    const concealed = num(s.concealedSamples);
+    out = {
+      at: num(s.timestamp) ?? Date.now(),
+      packets: num(s.packetsReceived) ?? 0,
+      lost: Math.max(0, num(s.packetsLost) ?? 0),
+      frames: num(s.framesDecoded),
+      freezes: num(s.freezeCount),
+      freezeSeconds: num(s.totalFreezesDuration),
+      dropped: num(s.framesDropped),
+      samples: num(s.totalSamplesReceived),
+      // concealment while the other side was silent costs nothing anyone hears
+      concealed:
+        concealed === undefined ? undefined : concealed - (num(s.silentConcealedSamples) ?? 0),
+      jitterDelay: num(s.jitterBufferDelay),
+      jitterEmitted: num(s.jitterBufferEmittedCount),
+      decodeTime: num(s.totalDecodeTime),
+      gaps: num(s.totalInterFrameDelay),
+      gapsSquared: num(s.totalSquaredInterFrameDelay),
+      pauses: num(s.pauseCount),
+      pauseSeconds: num(s.totalPausesDuration),
+      plis: num(s.pliCount),
+      nacks: num(s.nackCount),
+      stretched:
+        num(s.insertedSamplesForDeceleration) !== undefined ||
+        num(s.removedSamplesForAcceleration) !== undefined
+          ? (num(s.insertedSamplesForDeceleration) ?? 0) +
+            (num(s.removedSamplesForAcceleration) ?? 0)
+          : undefined,
+      jitter: num(s.jitter),
+      hwDec: typeof s.powerEfficientDecoder === 'boolean' ? s.powerEfficientDecoder : undefined,
+      readAt: Date.now(),
+    };
+  });
+  return out;
+}
+
+/**
+ * What a received track did between two readings of its totals; nothing from a first reading, or from totals that
+ * went back (a receiver started over). A total a browser doesn't keep is left out. resumedAt (1.0.17) is when this
+ * client last turned the video back on after turning it off itself (RemoteTrackPublication.meshOnAt), unless a
+ * reading told that gap already.
+ */
+export function receiverReading(
+  sid: string,
+  kind: 'audio' | 'video',
+  prev: ReceiverTotals | undefined,
+  now: ReceiverTotals,
+  height?: number,
+  resumedAt?: number,
+): MeshReceiverTrack | undefined {
+  if (!prev || now.at <= prev.at || now.packets < prev.packets) {
+    return undefined;
+  }
+  const seconds = (now.at - prev.at) / 1000;
+  const delta = (a?: number, b?: number) =>
+    a !== undefined && b !== undefined && b >= a ? b - a : undefined;
+  const out: MeshReceiverTrack = { sid, kind };
+  const received = now.packets - prev.packets;
+  const lost = Math.max(0, now.lost - prev.lost);
+  if (received + lost > 0) {
+    out.lost = round1((lost * 100) / (received + lost));
+  }
+  const delay = delta(prev.jitterDelay, now.jitterDelay);
+  const emitted = delta(prev.jitterEmitted, now.jitterEmitted);
+  if (delay !== undefined && emitted) {
+    out.jbMs = Math.round((delay * 1000) / emitted);
+  }
+  if (kind === 'video') {
+    const frames = delta(prev.frames, now.frames);
+    if (frames !== undefined) {
+      out.fps = round1(frames / seconds);
+    }
+    if (height) {
+      out.height = height;
+    }
+    let freezes = delta(prev.freezes, now.freezes);
+    let frozen = delta(prev.freezeSeconds, now.freezeSeconds);
+    const pauses = delta(prev.pauses, now.pauses);
+    const paused = delta(prev.pauseSeconds, now.pauseSeconds);
+    // 1.0.17: a gap this client made itself, turning the video off (its tile hidden or off the screen, the page in the
+    // background), isn't the call's (2026-10-24: the live view's "paused 1× 16.1 s" and "stutters ±870 ms" after a
+    // tab switch). A video turned back on since just before the last reading owns the pauses ending in this
+    // one, or the one freeze its gap came out as when it was too short for a pause; they're told apart as hiddenGaps.
+    const resumed = resumedAt !== undefined && resumedAt > (prev.readAt ?? prev.at) - RESUME_MS;
+    let hidden: { gaps: number; seconds?: number } | undefined;
+    if (resumed && pauses) {
+      hidden = { gaps: pauses, seconds: paused };
+    } else if (resumed && freezes === 1) {
+      hidden = { gaps: 1, seconds: frozen };
+      freezes = 0;
+      frozen = 0;
+    }
+    if (hidden) {
+      out.hiddenGaps = hidden.gaps;
+      if (hidden.seconds !== undefined) {
+        out.hiddenGapMs = Math.round(hidden.seconds * 1000);
+      }
+    }
+    if (freezes !== undefined) {
+      out.freezes = freezes;
+      if (frozen !== undefined) {
+        out.freezeMs = Math.round(frozen * 1000);
+      }
+    }
+    const dropped = delta(prev.dropped, now.dropped);
+    if (dropped !== undefined) {
+      out.dropped = dropped;
+    }
+    // 1.0.16: how it decodes, how evenly it shows, what it asked for (each only where there's something to say)
+    const decode = delta(prev.decodeTime, now.decodeTime);
+    if (frames && decode !== undefined) {
+      out.decodeMs = round1((decode * 1000) / frames);
+    }
+    if (now.hwDec !== undefined) {
+      out.hwDec = now.hwDec;
+    }
+    let gaps = delta(prev.gaps, now.gaps);
+    let squared = delta(prev.gapsSquared, now.gapsSquared);
+    let shown = frames;
+    if (resumed) {
+      // Chrome adds every gap to both sums, a pause's and a freeze's too, as its very length (VideoQualityObserver2),
+      // so one hidden gap comes out exactly; several, or one no total tells, leave the spread unsaid this reading
+      if (
+        hidden?.gaps === 1 &&
+        hidden.seconds !== undefined &&
+        frames &&
+        gaps !== undefined &&
+        squared !== undefined
+      ) {
+        gaps -= hidden.seconds;
+        squared -= hidden.seconds * hidden.seconds;
+        shown = frames - 1;
+      } else {
+        gaps = undefined;
+      }
+    }
+    if (shown && shown > 1 && gaps !== undefined && squared !== undefined) {
+      const mean = gaps / shown;
+      out.unevenMs = Math.round(Math.sqrt(Math.max(0, squared / shown - mean * mean)) * 1000);
+    }
+    if (pauses && !hidden) {
+      out.pauses = pauses;
+      if (paused !== undefined) {
+        out.pauseMs = Math.round(paused * 1000);
+      }
+    }
+    const plis = delta(prev.plis, now.plis);
+    if (plis) {
+      out.plis = plis;
+    }
+    const nacks = delta(prev.nacks, now.nacks);
+    if (nacks) {
+      out.nacks = nacks;
+    }
+  } else {
+    const samples = delta(prev.samples, now.samples);
+    const concealed = delta(prev.concealed, now.concealed);
+    if (samples && concealed !== undefined) {
+      out.concealed = round1((concealed * 100) / samples);
+    }
+    const stretched = delta(prev.stretched, now.stretched);
+    if (samples && stretched) {
+      out.stretched = round1((stretched * 100) / samples);
+    }
+  }
+  if (now.jitter !== undefined && now.jitter >= 0.001) {
+    out.jitterMs = Math.round(now.jitter * 1000);
+  }
+  return out;
+}
+
+/** The height of the picture a receiver decodes now, from its stats. */
+export function receiverHeight(report: StatsLike): number | undefined {
+  let height: number | undefined;
+  report.forEach((s) => {
+    if (s?.type === 'inbound-rtp' && height === undefined) {
+      height = num(s.frameHeight);
+    }
+  });
+  return height;
+}
diff --git a/src/room/meshStats.test.ts b/src/room/meshStats.test.ts
